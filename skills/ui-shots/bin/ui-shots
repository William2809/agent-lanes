#!/usr/bin/env node
// ui-shots: log in to a local web app with headless Playwright and save
// screenshots of pages at several widths. Prints saved paths and one auth counter line.
// Uses the Playwright installed in the current project (run from its root).
import { createRequire } from "node:module"
import { readFileSync, mkdirSync, existsSync } from "node:fs"
import { join, resolve } from "node:path"
import { waitReady, readyTimeout, clickControl } from "./readiness.mjs"
import { authenticatedState, authCounts, authLine, redact } from "./auth-cache.mjs"

const args = process.argv.slice(2)
const opt = {
  base: "http://localhost:3000", login: "", envFile: ".env", role: "",
  emailEnv: "", passwordEnv: "", emailSel: 'input[name="email"]',
  passwordSel: 'input[name="password"]', submitSel: 'button[type="submit"]',
  widths: "1440,390", out: "", full: false, theme: "", wait: 1500, click: [], tag: "", console: false, noJs: false, cookies: [], evals: [], hover: [], focus: [],
}
const paths = []
for (let i = 0; i < args.length; i++) {
  const a = args[i]
  const next = () => args[++i]
  switch (a) {
    case "--base": opt.base = next(); break
    case "--allow-remote": opt.allowRemote = true; break
    case "--login": opt.login = next(); break
    case "--env-file": opt.envFile = next(); break
    case "--email-env": opt.emailEnv = next(); break
    case "--password-env": opt.passwordEnv = next(); break
    case "--auth-ttl": opt.authTtl = next(); break
    case "--as": { const r = next().toUpperCase(); opt.role = r; opt.tag ||= r.toLowerCase(); break }
    case "--widths": opt.widths = next(); break
    case "--out": opt.out = next(); break
    case "--full": opt.full = true; break
    case "--theme": opt.theme = next(); break
    case "--ready": opt.ready = next(); break
    case "--loaded": opt.loaded = next(); break
    case "--ready-timeout": opt.readyTimeout = next(); break
    case "--wait": opt.wait = Number(next()); break
    case "--click": opt.click.push(next()); break
    case "--tag": opt.tag = next(); break
    case "--console": opt.console = true; break
    case "--no-js": opt.noJs = true; break
    case "--cookie": opt.cookies.push(next()); break
    case "--eval": opt.evals.push(next()); break
    case "--hover": opt.hover.push(next()); break
    case "--focus": opt.focus.push(next()); break
    case "--verbose": opt.console = true; opt.verbose = true; break
    case "-h": case "--help":
      console.log(`usage: ui-shots [--as ROLE | --email-env VAR --password-env VAR] [--widths 1440,390]
  [--allow-remote] [--out DIR] [--full] [--theme dark|light] [--click "button text"]... [--tag name] [--console] [--no-js] [--cookie name=value]... PATH...
PATH may be a full URL (sets --base). Reads credentials from --env-file (default .env) by variable name; never prints them.
--as ROLE reads <PREFIX><ROLE>_EMAIL/_PASSWORD: PREFIX = UI_SHOTS_ROLE_PREFIX (env or .env), else the one .env key ending in _<ROLE>_EMAIL.
Auth: shared origin + role storageState cache; --auth-ttl SECONDS / UI_SHOTS_AUTH_TTL_SECONDS (default 21600).
Login page: --login, else UI_SHOTS_LOGIN (env or .env), else /login.
Credentials require localhost/127.0.0.1/[::1], unless --allow-remote or UI_SHOTS_ALLOW_REMOTE=1; cross-origin login redirects are refused.
--click uses the exact accessible name, preferring button/link/tab/combobox/textbox in that order; sr-only inputs are excluded;
  "role:button:Select date" selects an explicit role and exact name; ambiguous matches fail; "~text" matches a name containing text;
  "type:abc" types into the focused control, "press:Enter" presses a key (keyboard flows; they really submit if the keys do).
--ready-timeout MS / UI_SHOTS_READY_TIMEOUT_MS sets the discovery budget (default 15000); actions remain 5000 ms.
--loaded CSS adds a loaded-content signal alongside network-idle readiness.
--ready CSS waits for that visible selector before actions/probes; --ready networkidle waits for network idle (both bounded at 15 s).
--console prints browser console errors/warnings and page errors per shot (one line each, deduplicated); --verbose prints full messages.
--cookie name=value sets a cookie on the base URL before loading (e.g. a remembered UI choice).
--hover CSS / --focus CSS hover or keyboard-focus the first match just before the shot (cards, tooltips).
--eval "js" prints the JSON value of a page expression after the clicks, per shot (e.g. measure overflow).
--no-js logs in normally, then blocks the app's JS chunks: the server's streamed first paint, before hydration.`)
      process.exit(0)
    // A full URL sets the base (worktree ports) and keeps only its path.
    default: if (/^https?:\/\//.test(a)) { const u = new URL(a); opt.base = u.origin; paths.push(u.pathname + u.search + u.hash) } else paths.push(a)
  }
}
if (!paths.length) { console.error("ui-shots: give at least one PATH"); process.exit(2) }

const env = {}
if (existsSync(opt.envFile)) {
  for (const line of readFileSync(opt.envFile, "utf8").split("\n")) {
    const m = line.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*)\s*$/)
    if (m) env[m[1]] = m[2].replace(/^(["'])(.*)\1$/, "$2")
  }
}
const cred = (name) => process.env[name] ?? env[name]
opt.login ||= cred("UI_SHOTS_LOGIN") || "/login"
if (opt.role) {
  // Role credentials: an explicit prefix, else the single .env key that ends in _<ROLE>_EMAIL.
  let pre = cred("UI_SHOTS_ROLE_PREFIX")
  if (pre === undefined) { const k = Object.keys(env).filter((k) => k.endsWith(`_${opt.role}_EMAIL`) || k === `${opt.role}_EMAIL`); if (k.length === 1) pre = k[0].slice(0, -`${opt.role}_EMAIL`.length) }
  if (pre === undefined) { console.error(`ui-shots: no single .env key ends in _${opt.role}_EMAIL; set UI_SHOTS_ROLE_PREFIX`); process.exit(2) }
  opt.emailEnv ||= `${pre}${opt.role}_EMAIL`; opt.passwordEnv ||= `${pre}${opt.role}_PASSWORD`
}

const base = new URL(opt.base)
if (opt.emailEnv && (!['http:', 'https:'].includes(base.protocol) ||
    (!['localhost', '127.0.0.1', '[::1]'].includes(base.hostname) && !opt.allowRemote && process.env.UI_SHOTS_ALLOW_REMOTE !== '1'))) {
  console.error("ui-shots: refusing credentials for remote base; use --allow-remote or UI_SHOTS_ALLOW_REMOTE=1"); process.exit(2)
}

const require = createRequire(join(process.cwd(), "package.json"))
let chromium
try { ({ chromium } = require("@playwright/test")) } catch { ({ chromium } = require("playwright")) }

const out = resolve(opt.out || join(process.env.TMPDIR || "/tmp", "ui-shots"))
mkdirSync(out, { recursive: true })
const counts = authCounts()
const secrets = [cred(opt.emailEnv), cred(opt.passwordEnv)].filter(Boolean)
let browser
try {
  const readiness = readyTimeout(opt.readyTimeout)
  browser = await chromium.launch()
  const auth = opt.emailEnv ? await authenticatedState(browser, {
    base: opt.base, role: opt.role || `env:${opt.emailEnv}:${opt.passwordEnv}`, login: opt.login,
    emailSel: opt.emailSel, passwordSel: opt.passwordSel, submitSel: opt.submitSel, ttl: opt.authTtl,
    credentials: () => ({ email: cred(opt.emailEnv), password: cred(opt.passwordEnv) }),
  }, counts) : undefined
  const storageState = auth?.storageState
  for (const width of opt.widths.split(",").map(Number)) {
    const context = await browser.newContext({
      viewport: { width, height: width < 600 ? 844 : 900 },
      deviceScaleFactor: 1,
      colorScheme: opt.theme || undefined,
      storageState,
    })
    if (opt.cookies.length) {
      await context.addCookies(opt.cookies.map((c) => {
        const [name, ...rest] = c.split("=")
        return { name, value: rest.join("="), url: opt.base }
      }))
    }
    const page = await context.newPage()
    const logs = new Set()
    if (opt.console) {
      page.on("console", (m) => { if (m.type() === "error" || m.type() === "warning") logs.add(`${m.type()}: ${(opt.verbose ? m.text().slice(0, 4000) : m.text().split("\n")[0].slice(0, 300))}`) })
      page.on("pageerror", (e) => logs.add(`pageerror: ${String(e.message).split("\n")[0].slice(0, 300)}`))
    }
    let shooter = page, bare
    if (opt.noJs) {
      const state = await context.storageState()
      bare = await browser.newContext({
        viewport: { width, height: width < 600 ? 844 : 900 },
        deviceScaleFactor: 1,
        colorScheme: opt.theme || undefined,
        storageState: state,
      })
      shooter = await bare.newPage()
      // Inline stream scripts still swap Suspense content in; blocking the
      // chunks stops React from hydrating, so this is the server's paint.
      await shooter.route(/\/_next\/static\/chunks\/.*\.js(\?|$)/, (route) => route.abort())
    }
    for (const p of paths) {
      logs.clear()
      await shooter.goto(opt.base + p, { waitUntil: "domcontentloaded" })
      await waitReady(shooter, opt.ready, readiness, opt.loaded)
      for (const text of opt.noJs ? [] : opt.click) {
        // "type:abc" types into the focused control; "press:Enter" presses a key.
        if (text.startsWith("type:")) { await page.keyboard.type(text.slice(5), { delay: 20 }); await page.waitForTimeout(300); continue }
        if (text.startsWith("press:")) { await page.keyboard.press(text.slice(6)); await page.waitForTimeout(400); continue }
        await clickControl(page, text, readiness)
        await page.waitForTimeout(600)
      }
      await page.waitForTimeout(opt.wait)
      for (const sel of opt.noJs ? [] : opt.hover) { await page.locator(sel).first().hover(); await page.waitForTimeout(500) }
      for (const sel of opt.noJs ? [] : opt.focus) { await page.locator(sel).first().focus(); await page.keyboard.press("Shift"); await page.waitForTimeout(500) }
      const slug = p.replace(/^\//, "").replace(/[^a-zA-Z0-9=-]+/g, "_").slice(0, 80) || "root"
      const extra = opt.noJs ? "_nojs" : opt.hover.length || opt.focus.length ? "_hover" : opt.click.length ? "_" + opt.click.join("-").replace(/[^a-zA-Z0-9]+/g, "").slice(0, 40) : ""
      const file = join(out, `${opt.tag ? opt.tag + "_" : ""}${slug}${extra}_${width}.png`)
      await shooter.screenshot({ path: file, fullPage: opt.full, caret: "initial" })
      console.log(file)
      for (const line of logs) console.log(redact(`  ${line}`, secrets))
      for (const expr of opt.evals) console.log(redact(`  eval: ${JSON.stringify(await page.evaluate(expr))}`, secrets))
    }
    if (bare) await bare.close()
    await context.close()
  }
} catch (error) {
  console.error(`ui-shots: ${redact(error.message, secrets).split("\n")[0]}`)
  process.exitCode = error.credentialRefusal ? 2 : 1
} finally {
  console.log(authLine("ui-shots", counts))
  if (browser) await browser.close()
}
