#!/usr/bin/env python3
# ABOUTME: Prints Codex plan usage from the newest session log's rate_limits event (no API call).
# ABOUTME: Usage: codex-limit  ->  "codex 70% used (weekly), resets ...";  codex-limit --pct  ->  "70" (highest window)
import glob, json, os, time, sys
def mtime(f):
    try: return os.path.getmtime(f)
    except OSError: return 0  # broken/looping archive links
# Scan only the newest two month folders to bound local log discovery.
months = sorted(glob.glob(os.path.expanduser("~/.codex/sessions/*/*")))[-2:]
files = sorted((f for m in months for f in glob.glob(m + "/*/*.jsonl")), key=mtime, reverse=True)[:30]
for f in files:
    rl = None
    for line in open(f, errors="ignore"):
        if '"rate_limits"' not in line: continue
        try: o = json.loads(line)
        except Exception: continue
        def find(x):
            if isinstance(x, dict):
                if isinstance(x.get("rate_limits"), dict): return x["rate_limits"]
                for v in x.values():
                    r = find(v)
                    if r: return r
            elif isinstance(x, list):
                for v in x:
                    r = find(v)
                    if r: return r
        rl = find(o) or rl
    if rl: break
else:
    print("codex-limit: no rate_limits event in recent sessions"); sys.exit(1)
if "--pct" in sys.argv:
    print(int(max((rl.get(k) or {}).get("used_percent", 0) for k in ("primary", "secondary")))); sys.exit(0)
out = []
for k in ("primary", "secondary"):
    w = rl.get(k)
    if not w: continue
    name = {300: "5h", 10080: "weekly"}.get(w["window_minutes"], f'{w["window_minutes"]}m')
    out.append(f'{w["used_percent"]:.0f}% used ({name}), resets {time.strftime("%a %d %b %H:%M", time.localtime(w["resets_at"]))}')
c = rl.get("credits") or {}
age = int((time.time() - os.path.getmtime(f)) / 60)
print("codex " + "; ".join(out) + (f', credits {c.get("balance")}' if c.get("has_credits") else "")
      + (" LIMIT REACHED" if rl.get("rate_limit_reached_type") else "") + f" (as of {age} min ago)")
