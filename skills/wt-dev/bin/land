#!/bin/sh
# ABOUTME: Lands one or more wt-dev worktrees as a merge train: stacks them in order, runs cheap
# ABOUTME: local preflight, ONE full remote-ci check on the stack tip, then ff-merges and removes them.
# Usage (inside the repo's main checkout): land <worktree>... [--keep]
# Prints one line per step, then "LANDED <sha>" or "FAILED <step>". Run as one background command.
# On a red stack tip, rerun with fewer worktrees (the failing step names the commit range).
set -u
keep=0; names=""
for a in "$@"; do [ "$a" = "--keep" ] && keep=1 || names="$names $a"; done
[ -n "$names" ] || { echo "usage: land <worktree>... [--keep]"; exit 2; }
main=$(git rev-parse --show-toplevel) || exit 1
base=$(git -C "$main" rev-parse --abbrev-ref HEAD)
# The branch to land on, recorded now: a check that switches the main checkout must not redirect the merge.
target=$(git -C "$main" symbolic-ref -q HEAD) || target=""
# LAND_TARGET (environment variable, set by mq): the branch the queue lands on; refuse any other.
[ -z "${LAND_TARGET:-}" ] || [ "$target" = "$LAND_TARGET" ] ||
  { echo "FAILED target moved (main checkout is on $base, not ${LAND_TARGET#refs/heads/})"; exit 1; }
[ -n "$target" ] || { echo "FAILED main checkout is not on a branch"; exit 1; }
restore=""
# LAND_TAIL (environment variable, set by mq): file that gets a bounded raw tail of a failed step's output,
# so mq can classify transient faults the short summary below drops. Same trust as the runner's own logs.
[ -z "${LAND_TAIL:-}" ] || : >"$LAND_TAIL"
keep_tail() { [ -z "${LAND_TAIL:-}" ] || printf '%s\n' "$out" | tail -80 | cut -c1-300 >"$LAND_TAIL"; }
# On failure, put every stacked worktree back on its own original commit, so a failed
# train never leaves one batch carrying another's commits.
fail() {
  for pair in $restore; do git -C "${pair%%=*}" reset -q --hard "${pair#*=}" 2>/dev/null; done
  [ -n "$restore" ] && echo "restored worktrees to their original commits"
  echo "FAILED $*"; exit 1
}

# 1. Stack: each worktree rebases onto the previous one's tip (the first onto the branch).
onto=$base; last=""; last_name=""
for name in $names; do
  wt=$(wt-dev path "$name") || fail "no worktree $name"
  [ -z "$(git -C "$wt" status --porcelain -- . ':!.reviews')" ] || fail "$name dirty (commit first)"
  [ "$(git -C "$wt" rev-list --count "$base..HEAD")" -gt 0 ] || fail "$name has nothing to land"
  restore="$restore $wt=$(git -C "$wt" rev-parse HEAD)"
  git -C "$wt" rebase -q "$onto" >/dev/null 2>&1 || { git -C "$wt" rebase --abort 2>/dev/null; fail "$name conflicts onto $onto"; }
  onto=$(git -C "$wt" rev-parse HEAD); last=$wt; last_name=$name
  echo "stacked $name"
done
wt=$last
command -v migcheck >/dev/null && { migcheck "$wt" || fail "migration journal (renumber with a newer when)"; }

# 2. Baseline once, on the tip.
if [ -f "$wt/tools/check-file-size.mjs" ]; then
  out=$(cd "$wt" && node tools/check-file-size.mjs --update 2>&1) || { printf "%s\n" "$out" | tail -8; fail "file-size ratchet"; }
  git -C "$wt" diff --quiet -- tools/file-size-baseline.json ||
    { git -C "$wt" commit -q -m "chore(tooling): lower file-size baseline" -- tools/file-size-baseline.json; echo "baseline lowered"; }
fi

# 3. Preflight: seconds-cheap guards that otherwise cost a full remote round.
# Install when dependencies are missing (--no-install worktree) or a lockfile differs from the
# one last installed here (the rebase picked up a new dependency: without this, lanes fail
# typecheck after another lane added a package). wt-dev picks the commands from the lockfiles.
out=$(wt-dev install "$last_name" --if-changed 2>&1) || { printf '%s\n' "$out" | tail -6; fail "install"; }
[ -z "$out" ] || printf '%s\n' "$out"
if [ -x "$main/tools/land-preflight.sh" ]; then
  out=$(cd "$wt" && sh "$main/tools/land-preflight.sh" "$base" 2>&1) || { keep_tail; printf '%s\n' "$out" | tail -8; fail "preflight"; }
  echo "preflight ok"
fi

# 4. One full check on the stack tip.
sha=$(git -C "$wt" rev-parse --short HEAD); full=$(git -C "$wt" rev-parse HEAD); tries=0
check=remote-ci
if [ -f "$wt/package.json" ] && command -v node >/dev/null && node -e 'const p = require(process.argv[1]); process.exit(typeof p.scripts?.["check:remote"] === "string" ? 0 : 1)' "$wt/package.json"; then check=pnpm; fi
while :; do
  # LAND_CHECK (environment variable): run this command in the worktree instead, e.g. without a runner machine.
  if [ -n "${LAND_CHECK:-}" ]; then out=$(cd "$wt" && sh -c "$LAND_CHECK" 2>&1)
  elif [ "$check" = pnpm ]; then out=$(cd "$wt" && pnpm -s check:remote --summary "$sha" 2>&1)
  else out=$(cd "$wt" && remote-ci check --summary "$sha" 2>&1); fi
  rc=$?
  [ $rc -eq 75 ] || break
  tries=$((tries + 1)); [ $tries -lt 120 ] || fail "runner busy for an hour"
  sleep 30
done
[ $rc -eq 0 ] || { keep_tail; printf '%s\n' "$out" | grep -E "FAIL|Failed:|rror" | head -8; fail "check rc=$rc on $sha ($base..$sha)"; }
# Only the tree that was checked may land: a check that edits tracked files or commits tested something else.
changed=$(git -C "$wt" status --porcelain --untracked-files=no)
if [ -n "$changed" ] || [ "$(git -C "$wt" rev-parse HEAD)" != "$full" ]; then
  [ -z "$changed" ] || printf '%s\n' "$changed" | head -5
  fail "check changed tracked files (the checked tree is not commit $sha)"
fi
echo "check green ($sha)"

# 5. Merge and clean up.
[ "$(git -C "$main" symbolic-ref -q HEAD)" = "$target" ] || fail "target moved (main checkout left $base during the check)"
prev=$(git -C "$main" rev-parse HEAD)
git -C "$main" merge -q --ff-only "$sha" 2>/dev/null || fail "ff-merge ($base moved; rerun land)"
# Optional repo hook: refresh the main checkout (install, migrate, health) after the merge.
# Contract: runs in the main checkout as `tools/post-land.sh OLD_SHA NEW_SHA` (env LAND_BRANCH);
# its lines starting with "refresh:" are shown; a failure is reported, never undoes the land.
if [ -x "$main/tools/post-land.sh" ]; then
  out=$(cd "$main" && LAND_BRANCH=$base ./tools/post-land.sh "$prev" "$sha" 2>&1); rc=$?
  printf '%s\n' "$out" | grep '^refresh:' || true
  [ $rc -eq 0 ] || echo "refresh: post-land FAILED (rc=$rc): $(printf '%s\n' "$out" | grep -v '^refresh:' | tail -1)"
fi
[ $keep -eq 1 ] || for name in $names; do
  cleanup=$(wt-dev rm "$name" 2>&1) || echo "cleanup failed: $name ($(printf '%s\n' "$cleanup" | tail -1))"
done
echo "LANDED $sha on $base"
