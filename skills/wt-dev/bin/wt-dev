#!/usr/bin/env bash
# wt-dev: one git worktree + its own dev server and database copy per agent session.
# Usage (run inside the repo):
#   wt-dev new <name> [--from <ref>] [--branch <b>] [--port N] [--app apps/web] [--no-install] [--shared-db]
#   Dev server: a preset found in --app / apps/web / web / the root (Next, Nuxt, SvelteKit, Astro, Angular,
#   Vite, Django, Rails, Laravel, Phoenix) or WT_DEV_CMD; PORT is set; ready when the port listens.
#   No preset and no WT_DEV_CMD: the worktree gets no server. Settings: optional .wt-dev.conf in the repo.
#   Installs follow the lockfiles (pnpm, npm, yarn, bun, uv, poetry, bundler, composer, mix) or WT_DEV_INSTALL.
#   Own database: a localhost Postgres or MySQL/MariaDB DATABASE_URL is cloned to <db>_wt_<name>, an SQLite
#   file is copied, WT_DEV_DB_CLONE/WT_DEV_DB_DROP run for anything else; the worktree gets a real .env
#   pointing at its copy; `rm` drops it. Clone failures remove the fresh worktree; --shared-db /
#   WT_DEV_SHARED_DB=1 opts out. Remote databases stay shared with a warning. No DATABASE_URL means no database.
#   Setups share max(1, logical CPUs / 2) slots across repos; WT_DEV_MAX_SETUPS overrides.
#   wt-dev sleep-idle [--minutes N] [-n]   # sleep idle servers (default 30 min); -n previews
#   `new` quietly sleeps idle servers first. `ls` shows sleeping; `start` wakes them.
#   Sleeping drops the worktree's build caches (preset or WT_DEV_CACHE). drop-caches does it for every stopped worktree.
#   wt-dev install <name> [--if-changed] [-n]   # (re)install deps; --if-changed skips unchanged lockfiles; -n prints
#   wt-dev start|stop|log|path <name>      wt-dev ls      wt-dev rm <name>
set -euo pipefail

die() { echo "wt-dev: $*" >&2; exit 1; }
repo=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "not in a git repo"
repo=$(cd "$repo/.." && pwd)
repo_name=$(basename "$repo" | tr ' ' '-')
helper="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/wtdev_db.py"
# Optional per-repo settings (committed, sourced as shell): WT_DEV_APP, WT_DEV_CMD, WT_DEV_INSTALL,
# WT_DEV_CACHE, WT_DEV_URL_VARS, WT_DEV_READY_TIMEOUT, WT_DEV_READY_ANY, WT_DEV_DB_VAR, WT_DEV_DB_CLONE, WT_DEV_DB_DROP.
# shellcheck disable=SC1091
[ -f "$repo/.wt-dev.conf" ] && . "$repo/.wt-dev.conf"
dbvar=${WT_DEV_DB_VAR:-DATABASE_URL}
root="$HOME/worktrees/$repo_name"
state="$HOME/.cache/wt-dev/$repo_name"
mkdir -p "$root" "$state"

cmd=${1:-}; shift || true
name=""
[[ "$cmd" =~ ^(new|start|stop|log|path|rm|install)$ ]] && { name=${1:-}; [ -n "$name" ] || die "$cmd needs a name"; shift; }
from=HEAD; branch=""; port=""; app=""; install=1; shared_db=${WT_DEV_SHARED_DB:-0}
minutes=30; dry_run=0; if_changed=0
while [ $# -gt 0 ]; do
  case "$1" in
    --from) from=$2; shift 2;; --branch) branch=$2; shift 2;;
    --port) port=$2; shift 2;; --app) app=$2; shift 2;;
    --no-install) install=0; shift;; --shared-db) shared_db=1; shift;;
    --minutes) [ "$cmd" = sleep-idle ] || die "--minutes is for sleep-idle"; minutes=${2:?--minutes needs a number}; shift 2;;
    -n) [ "$cmd" = sleep-idle ] || [ "$cmd" = install ] || die "-n is for sleep-idle and install"; dry_run=1; shift;;
    --if-changed) [ "$cmd" = install ] || die "--if-changed is for install"; if_changed=1; shift;;
    *) die "unknown option $1";;
  esac
done
[[ "$minutes" =~ ^[0-9]+$ ]] || die "--minutes needs a nonnegative integer"
minutes=$((10#$minutes))
[ -z "$name" ] || { [[ "$name" =~ ^[a-zA-Z0-9_.-]+$ ]] && [ "$name" != . ] && [ "$name" != .. ]; } || die "invalid worktree name"
wt="$root/$name"
setup_slot=""
release_setup() { [ -z "$setup_slot" ] || { rm -rf "$setup_slot"; setup_slot=""; }; }
trap release_setup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# A short advisory guard serializes mkdir + PID publication + stale-slot moves.
# It releases even if its process dies; servers never hold a setup slot.
acquire_setup() {
  local cpus limit slots="$HOME/.cache/wt-dev/setup-slots" waited=0
  cpus=$(sysctl -n hw.logicalcpu 2>/dev/null || getconf _NPROCESSORS_ONLN)
  limit=${WT_DEV_MAX_SETUPS:-$((cpus / 2))}
  [[ "$limit" =~ ^[0-9]+$ ]] || die "WT_DEV_MAX_SETUPS needs a positive integer"
  limit=$((10#$limit)); [ "$limit" -ge 1 ] || limit=1
  command -v python3 >/dev/null || die "python3 missing (setup slots need it)"
  mkdir -p "$slots"
  while :; do
    setup_slot=$(python3 - "$slots" "$limit" "$$" <<'SLOTS'
import fcntl, os, shutil, sys, uuid
root, limit, pid = sys.argv[1], int(sys.argv[2]), sys.argv[3]
with open(root + '/.guard', 'a') as guard:
    fcntl.flock(guard, fcntl.LOCK_EX)
    for i in range(1, limit + 1):
        slot = root + '/' + str(i)
        if os.path.isdir(slot):
            try:
                with open(slot + '/pid') as f:
                    owner = int(f.read().strip())
                if owner <= 0:
                    raise ValueError()
                os.kill(owner, 0)
                continue
            except PermissionError:
                continue
            except (ProcessLookupError, FileNotFoundError, ValueError):
                stale = slot + '.stale-' + uuid.uuid4().hex
                os.rename(slot, stale)
                shutil.rmtree(stale, ignore_errors=True)
        os.mkdir(slot)
        with open(slot + '/pid', 'w') as f:
            f.write(pid + '\n')
        print(slot)
        break
SLOTS
    ) || die "could not acquire a setup slot"
    [ -z "$setup_slot" ] || return 0
    if [ "$waited" = 0 ]; then echo "wt-dev: waiting for a setup slot ($limit/$limit busy)"; waited=1; fi
    sleep 1
  done
}

has_dep() { grep -qE "\"$1\"[[:space:]]*:" "$2/package.json" 2>/dev/null; }
pyrun() {  # the worktree's Python: its venv (made by uv sync / poetry), else the tool's runner
  if [ -x "$wt/.venv/bin/python" ]; then echo "$wt/.venv/bin/python"
  elif [ -f "$wt/uv.lock" ]; then echo "uv run python"
  elif [ -f "$wt/poetry.lock" ]; then echo "poetry run python"
  else echo python3; fi
}
# preset DIR: sets p_name, p_cmd (run by sh in DIR with PORT set), p_cache (dirs under DIR) and p_urls
# (extra .env URL variables pointed at the port); 1 = none. Only frameworks whose dev command is
# unambiguous; anything else (Go, Rust, Express...) uses WT_DEV_CMD.
preset() {
  local d=$1; p_cache=""; p_urls=""
  # Backend frameworks first: Rails, Laravel and Django apps often carry a package.json for assets.
  if [ -f "$d/manage.py" ]; then p_name=django; p_cmd="$(pyrun) manage.py runserver 127.0.0.1:\"\$PORT\""
  elif [ -x "$d/bin/rails" ]; then p_name=rails; p_cmd='bin/rails server -b 127.0.0.1 -p "$PORT"'; p_cache=tmp/cache
  elif [ -f "$d/artisan" ]; then p_name=laravel; p_cmd='php artisan serve --host=127.0.0.1 --port="$PORT"'; p_urls=APP_URL
  elif [ -f "$d/mix.exs" ] && grep -q ':phoenix' "$d/mix.exs"; then p_name=phoenix; p_cmd='mix phx.server'; p_cache=_build/dev/lib
  elif [ -f "$d/package.json" ]; then
    if has_dep next "$d"; then p_name=next; p_cmd='npx next dev -p "$PORT"'; p_cache=.next
    elif has_dep nuxt "$d"; then p_name=nuxt; p_cmd='npx nuxi dev --port "$PORT"'; p_cache=".nuxt node_modules/.cache"
    elif has_dep @sveltejs/kit "$d"; then p_name=sveltekit; p_cmd='npx vite dev --port "$PORT" --strictPort'; p_cache=".svelte-kit node_modules/.vite"
    elif has_dep astro "$d"; then p_name=astro; p_cmd='npx astro dev --port "$PORT"'; p_cache="node_modules/.vite node_modules/.astro"
    elif has_dep @angular/core "$d"; then p_name=angular; p_cmd='npx ng serve --port "$PORT"'; p_cache=.angular
    elif has_dep vite "$d"; then p_name=vite; p_cmd='npx vite --port "$PORT" --strictPort'; p_cache=node_modules/.vite
    else return 1; fi
  else return 1; fi
}
# detect_app: the app folder relative to the worktree, or "" when there is no server to start.
detect_app() {
  [ -n "$app" ] && { echo "$app"; return; }
  [ -n "${WT_DEV_APP:-}" ] && { echo "$WT_DEV_APP"; return; }
  [ -f "$state/$name.app" ] && { cat "$state/$name.app"; return; }
  local d
  for d in apps/web web .; do preset "$wt/$d" && { echo "$d"; return; }; done
  [ -n "${WT_DEV_CMD:-}" ] && { echo .; return; }
  echo ""
}
free_port() { local p=3001; while lsof -iTCP:$p -sTCP:LISTEN >/dev/null 2>&1; do p=$((p+1)); done; echo $p; }
# Per-worktree database helpers. URLs are never printed (they hold passwords).
main_url() { grep -E "^(export )?$dbvar=" "$repo/.env" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"'"'"; }
db_of() { local u=${1%%\?*}; echo "${u##*/}"; }
with_db() { local u=$1 d=$2 q=""; case "$u" in *\?*) q="?${u#*\?}"; u=${u%%\?*};; esac; echo "${u%/*}/$d$q"; }
# helper_db ENGINE: SQLite and MySQL copies (wtdev_db.py), then the worktree .env it wrote.
helper_db() {
  local out label token
  out=$(python3 "$helper" clone "$1" "$repo" "$wt" "$(detect_app)" "$name" "$dbvar" 2>&1) || { db_warning=$(printf '%s\n' "$out" | tail -1); return 1; }
  label=${out%%$'\t'*}; token=${out#*$'\t'}
  if [ -f "$wt/.env.wt-dev.new" ]; then rm -f "$wt/.env" && mv "$wt/.env.wt-dev.new" "$wt/.env" || { db_warning="clone environment could not be saved"; return 1; }; fi
  [ -z "$token" ] || echo "$1 $token" >"$state/$name.db"
  echo "$label"
}
# hook_db: WT_DEV_DB_CLONE prints the copy's URL as its last line (nothing = keep the variable as is).
hook_db() {
  local out new
  out=$(cd "$wt" && WT_DEV_NAME=$name WT_DEV_WORKTREE=$wt WT_DEV_SOURCE_URL=$(main_url) sh -c "$WT_DEV_DB_CLONE") || { db_warning="WT_DEV_DB_CLONE failed"; return 1; }
  new=$(printf '%s\n' "$out" | tail -1)
  echo "hook" >"$state/$name.db"
  [ -n "$new" ] || { echo "database: copied by WT_DEV_DB_CLONE"; return 0; }
  (umask 077; printf '%s\n' "$new" >"$state/$name.dburl")
  printf '%s\n' "$new" | python3 "$helper" env-set "$repo/.env" "$wt/.env.wt-dev.new" "$dbvar" && rm -f "$wt/.env" && mv "$wt/.env.wt-dev.new" "$wt/.env" ||
    { db_warning="clone environment could not be saved"; return 1; }
  echo "database: copied by WT_DEV_DB_CLONE"
}
own_db() {
  local u; u=$(main_url) || true
  [ -n "${WT_DEV_DB_CLONE:-}" ] && { hook_db; return; }
  [ -n "$u" ] || return 0
  case "$u" in sqlite*|file:*|*.db|*.sqlite|*.sqlite3) helper_db sqlite; return;; esac
  case "$u" in *://localhost[:/]*|*://127.0.0.1[:/]*|*@localhost[:/]*|*@127.0.0.1[:/]*) ;; *)
    echo "wt-dev: own database not created ($dbvar is not on localhost); using the shared one"; return 0;; esac
  case "$u" in
    postgres://*|postgresql://*) ;;
    mysql://*|mysql2://*|mariadb://*) helper_db mysql; return;;
    *) db_warning="no database adapter for ${u%%:*}:// (set WT_DEV_DB_CLONE and WT_DEV_DB_DROP in .wt-dev.conf)"; return 1;;
  esac
  local tool
  for tool in pg_dump psql createdb pg_restore; do
    command -v "$tool" >/dev/null || { db_warning="$tool missing"; return 1; }
  done
  local src; src=$(db_of "$u"); local dst; dst="${src}_wt_$(echo "$name" | tr -c 'a-zA-Z0-9\n' '_' | tr 'A-Z' 'a-z')"
  local admin; admin=$(with_db "$u" postgres)
  # A same-named clone can only be a leftover: `new` already refused an existing worktree.
  psql "$admin" -q -c "drop database if exists \"$dst\" with (force)" >/dev/null 2>&1
  createdb --maintenance-db="$admin" "$dst" 2>/dev/null || { db_warning="createdb failed"; return 1; }
  local clone; clone=$(with_db "$u" "$dst")
  local failed="" source_tables clone_tables
  local table_sql="select n.nspname, count(*) from pg_class c join pg_namespace n on n.oid = c.relnamespace where c.relkind in ('r', 'p', 'f') and n.nspname !~ '^pg_' and n.nspname <> 'information_schema' group by n.nspname order by n.nspname collate \"C\""
  if ! pg_dump -Fc "$u" 2>/dev/null | pg_restore --exit-on-error -d "$clone" >/dev/null 2>&1; then
    failed="dump/restore failed"
  elif ! source_tables=$(psql "$u" -Atqc "$table_sql" 2>/dev/null) ||
       ! clone_tables=$(psql "$clone" -Atqc "$table_sql" 2>/dev/null); then
    failed="clone table counts could not be verified"
  elif [ "$source_tables" != "$clone_tables" ]; then
    failed="clone table counts differ from source"
  fi
  if [ -z "$failed" ]; then
    # Write privately before replacing the link; never write through it into the main .env.
    local line k v q
    if ! (
      umask 077
      while IFS= read -r line || [ -n "$line" ]; do
        k=${line%%=*}; v=${line#*=}; q=""
        case "$v" in
          \"*\") q='"'; v=${v#\"}; v=${v%\"};;
          \'*\') q="'"; v=${v#\'}; v=${v%\'};;
        esac
        case "$v" in *://*/"$src"|*://*/"$src"\?*)
          echo "$k=$q$(with_db "$v" "$dst")$q";;
        *) echo "$line";; esac
      done <"$repo/.env" >"$wt/.env.wt-dev.new"
    ) || ! rm -f "$wt/.env" || ! mv "$wt/.env.wt-dev.new" "$wt/.env" ||
         ! echo "$dst" >"$state/$name.db"; then
      failed="clone environment could not be saved"
    fi
  fi
  if [ -n "$failed" ]; then
    psql "$admin" -q -c "drop database if exists \"$dst\" with (force)" >/dev/null 2>&1 || failed="$failed; clone cleanup failed"
    db_warning="$failed"; return 1
  fi
  echo "database: $dst (clone of $src)"
}
drop_db() {
  [ -f "$state/$name.db" ] || return 0; local u kind tok; u=$(main_url); read -r kind tok <"$state/$name.db" || true
  case "$kind" in
    sqlite|mysql) python3 "$helper" drop "$kind" "$repo" "$wt" "$tok" "$dbvar";;
    hook) [ -n "${WT_DEV_DB_DROP:-}" ] || return 0
      (cd "$repo" && WT_DEV_NAME=$name WT_DEV_WORKTREE=$wt WT_DEV_DB_URL=$(cat "$state/$name.dburl" 2>/dev/null) sh -c "$WT_DEV_DB_DROP") && echo "dropped database (WT_DEV_DB_DROP)";;
    *) psql "$(with_db "$u" postgres)" -q -c "drop database if exists \"$kind\" with (force)" >/dev/null 2>&1 && echo "dropped database $kind";;
  esac
}
running() {
  local pid
  [ -f "$state/$name.pid" ] || return 1
  pid=$(cat "$state/$name.pid")
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] && kill -0 "$pid" 2>/dev/null || return 1
  # A reused PID is another process: the recorded start time must match.
  [ ! -f "$state/$name.pidstart" ] || [ "$(ps -o lstart= -p "$pid" 2>/dev/null)" = "$(cat "$state/$name.pidstart")" ]
}
# listener_ours PORT: the process listening on PORT belongs to this worktree's server tree.
listener_ours() {
  local l tree
  # Commands whose listener is another process (docker compose ...) opt out of the ownership check.
  [ "${WT_DEV_READY_ANY:-0}" != 1 ] || { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; return; }
  tree=" $(server_tree "$(cat "$state/$name.pid")") "
  for l in $(lsof -nP -t -iTCP:"$1" -sTCP:LISTEN 2>/dev/null); do case "$tree" in *" $l "*) return 0;; esac; done
  return 1
}

start() {
  rm -f "$state/$name.sleeping"
  running && { echo "already running: http://localhost:$(cat "$state/$name.port")"; return; }
  local a; a=$(detect_app)
  [ -n "$a" ] || { echo "no dev server: no known framework in apps/web, web or the root (set WT_DEV_CMD in .wt-dev.conf)"; return 0; }
  [ -d "$wt/$a" ] || die "app folder $a not found in the worktree"
  echo "$a" > "$state/$name.app"
  local runcmd cache urls
  if preset "$wt/$a"; then runcmd=${WT_DEV_CMD:-$p_cmd}; cache=${WT_DEV_CACHE-$p_cache}; urls=$p_urls
  elif [ -n "${WT_DEV_CMD:-}" ]; then runcmd=$WT_DEV_CMD; cache=${WT_DEV_CACHE:-}; urls=""
  else echo "no dev server: no known framework in $a (set WT_DEV_CMD in .wt-dev.conf)"; return 0; fi
  urls="${WT_DEV_URL_VARS:-BETTER_AUTH_URL NEXTAUTH_URL AUTH_URL} $urls"
  echo "$cache" > "$state/$name.cache"
  [ -n "$port" ] || port=$( [ -f "$state/$name.port" ] && ! lsof -iTCP:"$(cat "$state/$name.port")" -sTCP:LISTEN >/dev/null 2>&1 && cat "$state/$name.port" || free_port )
  ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1 || die "port $port is already in use"
  echo "$port" > "$state/$name.port"
  local log="$state/$name.log"
  local envargs=()
  if [ -f "$wt/.env" ]; then
    envargs=(-e "$wt/.env")
    # Auth libraries reject callbacks from another origin; point them at this port.
    for v in $urls; do
      grep -q "^$v=" "$wt/.env" && envargs+=(-v "$v=http://localhost:$port")
    done
    # Many worktree servers share one local Postgres (100 connections): keep each pool small.
    envargs+=(-v "DATABASE_POOL_MAX=${WT_DEV_POOL_MAX:-3}")
  fi
  local dotenv="$wt/node_modules/.bin/dotenv"
  (
    cd "$wt/$a"
    # WT_DEV=1 marks a disposable worktree server; projects can use it to skip
    # disk-heavy dev caches (a project can turn off its bundler's file-system cache).
    export WT_DEV=1 PORT=$port
    if [ ${#envargs[@]} -gt 0 ] && [ -x "$dotenv" ]; then
      nohup "$dotenv" "${envargs[@]}" -- sh -c "$runcmd" > "$log" 2>&1 &
    elif [ ${#envargs[@]} -gt 0 ]; then
      # No dotenv CLI (not a Node project): export the overrides, load the rest of .env underneath them.
      local i=1
      while [ $i -lt ${#envargs[@]} ]; do [ "${envargs[$((i-1))]}" = -v ] && export "${envargs[$i]}"; i=$((i+2)); done
      nohup python3 "$helper" env-exec "$wt/.env" -- sh -c "$runcmd" > "$log" 2>&1 &
    else
      nohup sh -c "$runcmd" > "$log" 2>&1 &
    fi
    echo $! > "$state/$name.pid"
    ps -o lstart= -p $! > "$state/$name.pidstart" 2>/dev/null || true
  )
  # Ready = something listens on the port (it was free before); works for every framework.
  local limit=${WT_DEV_READY_TIMEOUT:-90} t=0
  while [ $t -lt "$limit" ]; do
    listener_ours "$port" && break
    running || break
    sleep 1; t=$((t + 1))
  done
  listener_ours "$port" || { tail -5 "$log"; die "dev server not listening on :$port after ${t}s (another process may hold the port; log: $log)"; }
  echo "ready: http://localhost:$port  (ui-shots --base http://localhost:$port)"
}
stop() {
  if running; then
    local pid; pid=$(cat "$state/$name.pid")
    # The whole tree: wrappers (npx, uv run, autoreloaders) keep the real server as a grandchild.
    local p; for p in $(server_tree "$pid"); do kill "$p" 2>/dev/null || true; done
    echo "stopped $name"
  else echo "$name not running"; fi
  rm -f "$state/$name.pid" "$state/$name.pidstart"
}

clear_state() {
  rm -f "$state/$name".*  # small state files this tool wrote
}
server_tree() {
  ps -axo pid=,ppid= | awk -v root="$1" '
    { parent[$1]=$2 } END {
      tree[root]=1
      do { changed=0; for (p in parent) if (!tree[p] && tree[parent[p]]) { tree[p]=1; changed=1 } } while (changed)
      for (p in tree) if (tree[p]) printf "%s ", p
    }'
}
# Build caches (Next's .next is ~1 GB per worktree) are rebuilt on the next start, so a stopped
# server doesn't need them. Deletes only the recorded cache dirs inside this worktree; prints MB freed.
drop_cache() {
  local a d c mb total=0 found=0 caches real top
  a=$(cat "$state/$name.app" 2>/dev/null || echo apps/web)
  case "$a" in /*|*..*) return 0;; esac
  caches=$(cat "$state/$name.cache" 2>/dev/null || echo .next)
  top=$(cd "$wt" 2>/dev/null && pwd -P) || return 0
  for c in $caches; do
    case "$c" in /*|*..*) continue;; esac
    d="$wt/$a/$c"
    [ -d "$d" ] && [ ! -L "$d" ] || continue
    # Symlinks resolved: the cache must really live inside this worktree.
    real=$(cd "$d" && pwd -P) || continue
    case "$real" in "$top"/?*) ;; *) continue;; esac
    mb=$(du -sm "$d" 2>/dev/null | cut -f1); rm -rf "$d" && { total=$((total + ${mb:-0})); found=1; }
  done
  [ "$found" = 0 ] || echo "$total"
}
# install_cmds: one install command per line, from WT_DEV_INSTALL or the lockfiles at the worktree root.
lockfiles="pnpm-lock.yaml package-lock.json yarn.lock bun.lock bun.lockb uv.lock poetry.lock Gemfile.lock composer.lock mix.lock"
install_cmds() {
  if [ -n "${WT_DEV_INSTALL+x}" ]; then [ -z "$WT_DEV_INSTALL" ] || echo "$WT_DEV_INSTALL"; return 0; fi
  [ ! -f "$wt/pnpm-lock.yaml" ] || echo 'pnpm install --frozen-lockfile --prefer-offline'
  [ ! -f "$wt/package-lock.json" ] || echo 'npm ci --prefer-offline --no-audit --no-fund'
  if [ -f "$wt/yarn.lock" ]; then if [ -f "$wt/.yarnrc.yml" ]; then echo 'yarn install --immutable'; else echo 'yarn install --frozen-lockfile --prefer-offline'; fi; fi
  if [ -f "$wt/bun.lock" ] || [ -f "$wt/bun.lockb" ]; then echo 'bun install --frozen-lockfile'; fi
  [ ! -f "$wt/uv.lock" ] || echo 'uv sync --frozen'
  [ ! -f "$wt/poetry.lock" ] || echo 'poetry install'
  [ ! -f "$wt/Gemfile.lock" ] || echo 'bundle install --quiet'
  [ ! -f "$wt/composer.lock" ] || echo 'composer install --no-interaction --quiet'
  [ ! -f "$wt/mix.lock" ] || echo 'mix deps.get'
  return 0
}
# deps_present: the folders the detected installers fill still exist (a deleted one forces a reinstall).
deps_present() {
  { [ ! -f "$wt/package.json" ] || [ -d "$wt/node_modules" ]; } && { [ ! -f "$wt/uv.lock" ] || [ -d "$wt/.venv" ]; } &&
    { [ ! -f "$wt/composer.lock" ] || [ -d "$wt/vendor" ]; } && { [ ! -f "$wt/mix.lock" ] || [ -d "$wt/deps" ]; }
}
# install_deps: runs install_cmds; the stamp (lockfile blobs + commands) lets --if-changed skip.
install_deps() {
  local cmds stamp sum f c log="$state/$name.install.log"
  cmds=$(install_cmds)
  [ -n "$cmds" ] || return 0
  [ "$dry_run" = 0 ] || { printf '%s\n' "$cmds"; return 0; }
  stamp="$(git -C "$wt" rev-parse --absolute-git-dir)/wt-dev-install"
  sum=$( { printf '%s\n' "$cmds"; for f in $lockfiles; do [ ! -f "$wt/$f" ] || git -C "$wt" hash-object "$f"; done; } | shasum | cut -c1-40)
  if [ "$if_changed" = 1 ] && [ "$(cat "$stamp" 2>/dev/null)" = "$sum" ] && deps_present; then return 0; fi
  : >"$log"
  while IFS= read -r c; do
    (cd "$wt" && sh -c "$c") >>"$log" 2>&1 || { tail -5 "$log" >&2; echo "wt-dev: install failed: $c (log: $log)" >&2; return 1; }
  done <<<"$cmds"
  echo "$sum" >"$stamp"
  echo "installed deps ($(printf '%s\n' "$cmds" | awk '{print $1}' | paste -sd, -))"
}
sleep_idle() {
  local saved_name="$name" saved_wt="$wt" f pid modified now idle tree cwds dir freed
  # Missing/inaccessible cwd information is not evidence of an idle worktree.
  cwds=$(lsof -n -P -a -d cwd -F pn 2>/dev/null) || return 0
  now=$(date +%s)
  for f in "$state"/*.pid; do
    [ -f "$f" ] || continue
    name=${f##*/}; name=${name%.pid}; wt="$root/$name"
    [ -d "$wt" ] && running && [ -f "$state/$name.log" ] || continue
    modified=$(stat -f %m "$state/$name.log" 2>/dev/null || stat -c %Y "$state/$name.log" 2>/dev/null) || continue
    [[ "$modified" =~ ^[0-9]+$ ]] || continue
    idle=$(((now - modified) / 60)); [ "$idle" -ge "$minutes" ] || continue
    dir=$(cd "$wt" && pwd -P) || continue
    pid=$(cat "$f"); tree=$(server_tree "$pid") || continue
    if printf '%s\n' "$cwds" | awk -v dir="$dir" -v tree="$tree" '
      BEGIN { split(tree, p, " "); for (i in p) own[p[i]]=1 }
      /^p/ { pid=substr($0,2) }
      /^n/ { path=substr($0,2); if (!own[pid] && (path==dir || index(path,dir "/")==1)) busy=1 }
      END { exit !busy }'; then continue; fi
    if [ "$dry_run" = 1 ]; then echo "would sleep $name"
    else
      stop >/dev/null
      : >"$state/$name.sleeping"
      freed=$(drop_cache)
      echo "slept $name (idle $idle min${freed:+; freed ${freed} MB cache}; wt-dev start $name to wake)"
    fi
  done
  name="$saved_name"; wt="$saved_wt"
}

case "$cmd" in
  new)
    [ -e "$wt" ] && die "$wt exists"
    sleep_idle
    acquire_setup
    if [ -n "$branch" ]; then git -C "$repo" worktree add -q -b "$branch" "$wt" "$from"
    else git -C "$repo" worktree add -q --detach "$wt" "$from"; fi
    for f in "$repo"/.env "$repo"/.env.local "$repo"/apps/*/.env "$repo"/apps/*/.env.local; do
      [ -f "$f" ] || continue; rel=${f#"$repo/"}; ln -s "$f" "$wt/$rel"
    done
    if [ "$shared_db" != 1 ] && ! own_db; then
      reason=${db_warning:-database clone failed}
      git -C "$repo" worktree remove --force "$wt" || reason="$reason; fresh worktree cleanup failed"
      clear_state
      die "$reason; rerun with --shared-db (or WT_DEV_SHARED_DB=1) to use the main database on purpose"
    fi
    if [ $install = 1 ]; then install_deps >/dev/null || die "install failed in $wt"; fi
    echo "worktree: $wt ($(git -C "$wt" rev-parse --short HEAD)${branch:+, branch $branch})"
    start;;
  start) [ -d "$wt" ] || die "no worktree $name"; start;;
  install) [ -d "$wt" ] || die "no worktree $name"; install_deps;;
  stop) stop;;
  log) tail -n 40 "$state/$name.log";;
  path) echo "$wt";;
  rm)
    stop
    if [ ! -d "$wt" ]; then  # already gone: clean leftovers, say so plainly
      git -C "$repo" worktree prune; drop_db || true; clear_state; die "no worktree $name (not found; leftover state cleaned)"; fi
    # An SQLite file copied into the worktree is held aside (it would block the removal if git
    # tracks its folder) and put back if git refuses; it is deleted only after a successful removal.
    hold=""; dbrel=""
    case "$(cat "$state/$name.db" 2>/dev/null)" in "sqlite rel:"*)
      dbrel=$(cut -d: -f2- "$state/$name.db"); hold="$state/$name.dbhold"
      case "$dbrel" in /*|*..*) die "bad database state for $name";; esac
      # Only the database and SQLite's own side files: anything else untracked makes git refuse below.
      if [ -f "$wt/$dbrel" ] && [ ! -L "$wt/$dbrel" ]; then
        mkdir -p "$hold" || die "cannot hold $dbrel aside"
        for f in "$wt/$dbrel" "$wt/$dbrel-wal" "$wt/$dbrel-shm" "$wt/$dbrel-journal"; do
          if [ -f "$f" ] && [ ! -L "$f" ]; then mv "$f" "$hold/"; fi
        done
      else hold=""; fi;;
    esac
    if ! git -C "$repo" worktree remove "$wt"; then
      # Git can unregister the worktree, then fail its final rmdir because a process (a browser,
      # a dev server) wrote files meanwhile. Nothing tracked is left, so trash the remnant.
      real=$(cd "$wt" 2>/dev/null && pwd -P) || real=$wt
      if git -C "$repo" worktree list --porcelain | grep -qxF -e "worktree $wt" -e "worktree $real"; then
        [ -z "$hold" ] || mv "$hold"/* "$(dirname "$wt/$dbrel")/" && rmdir "$hold" 2>/dev/null
        die "worktree has changes; commit or move them first (not forced)"
      fi
      ctrash "$wt" >/dev/null || die "worktree unregistered but $wt could not be trashed"
      echo "trashed leftover files in $wt"
    fi
    if [ -n "$hold" ]; then rm -rf "$hold"; echo "dropped sqlite copy $(basename "$dbrel")"; rm -f "$state/$name.db"; fi
    drop_db || true
    clear_state; echo "removed $wt";;
  sleep-idle) sleep_idle;;
  drop-caches)  # build caches of every stopped/sleeping worktree in this repo
    total=0
    # A worktree some process works in (a worker, a build, a shell) keeps its cache.
    cwds=$(lsof -n -P -a -d cwd -Fn 2>/dev/null | sed -n 's/^n//p') || die "lsof failed; not dropping caches"
    for d in "$root"/*/; do
      [ -d "$d" ] || continue; name=$(basename "$d"); wt="$root/$name"
      running && continue
      dir=$(cd "$wt" && pwd -P)
      printf '%s\n' "$cwds" | awk -v d="$dir" '$0==d || index($0, d "/")==1 {f=1} END {exit !f}' && continue
      mb=$(drop_cache); [ -z "$mb" ] || { echo "dropped $name cache (${mb} MB)"; total=$((total + mb)); }
    done
    echo "freed ${total} MB";;
  ls)
    for d in "$root"/*/; do
      [ -d "$d" ] || continue; name=$(basename "$d")
      st=stopped; [ ! -f "$state/$name.sleeping" ] || st=sleeping; running && st="http://localhost:$(cat "$state/$name.port")"
      echo "$name  $(git -C "$d" rev-parse --abbrev-ref HEAD)@$(git -C "$d" rev-parse --short HEAD)  $st  dirty:$(git -C "$d" status --porcelain | wc -l | tr -d ' ')  db:$(cut -d' ' -f1 "$state/$name.db" 2>/dev/null || echo shared)"
    done;;
  *) sed -n '2,19p' "$0"; exit 1;;
esac
