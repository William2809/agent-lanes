#!/usr/bin/env python3
# ABOUTME: Checks Drizzle migration journals (unique numbers, increasing `when`) and unique decision numbers.
# ABOUTME: Drizzle skips a migration whose `when` is not newer than the last applied one, silently.
# Usage: migcheck [repo-dir]   (exit 1 with a reason line on a problem)
import glob, json, os, re, sys
root = sys.argv[1] if len(sys.argv) > 1 else "."
bad = 0
for j in glob.glob(os.path.join(root, "**/drizzle/meta/_journal.json"), recursive=True):
    if "node_modules" in j: continue
    e = json.load(open(j))["entries"]; seen = set(); prev = None
    recent = {x["tag"] for x in e[-10:]}  # older history may hold accepted duplicates
    for x in e:
        n = re.match(r"\d+", x["tag"]).group()
        if n in seen and x["tag"] in recent: print(f"migcheck: duplicate migration number {n} ({x['tag']}) in {j}"); bad = 1
        seen.add(n)
        if prev and x["when"] <= prev["when"]:
            print(f"migcheck: {x['tag']} when={x['when']} is not newer than {prev['tag']} when={prev['when']}; Drizzle would skip it"); bad = 1
        prev = x
# Decision records (docs/decisions/NNNN-*.md): parallel batches pick the same next number.
from collections import defaultdict
for ddir in glob.glob(os.path.join(root, "docs/decisions")):
    seen = defaultdict(list)
    for f in os.listdir(ddir):
        m = re.match(r"(\d{4})-", f)
        if m: seen[m.group(1)].append(f)
    for n, fs in sorted(seen.items()):
        if len(fs) > 1 and int(n) >= 100:  # older history may hold accepted duplicates
            print(f"migcheck: decision number {n} used twice: {', '.join(sorted(fs))}"); bad = 1
sys.exit(bad)
