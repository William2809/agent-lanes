#!/bin/bash
# ABOUTME: Runs a project's heavy checks on a separate runner machine so the dev machine stays cool (any project with .remote-ci.conf).
# ABOUTME: Route: direct link (e.g. Thunderbolt bridge) → named SSH host (e.g. over Tailscale) → exit 3 (defer; never silently run locally). See ../SKILL.md.
set -uo pipefail
kit=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# Machine-specific settings live outside the repo: ${AGENT_LANES_CONFIG:-~/.config/agent-lanes/config}.
#   REMOTE_CI_USER (default: your login) · REMOTE_CI_DIRECT_HOST (default: the bridge0 router, i.e. a Thunderbolt bridge)
#   REMOTE_CI_HOSTKEY_ALIAS (ssh HostKeyAlias for the direct route) · REMOTE_CI_HOST (ssh host for the fallback route,
#   or "local": this machine is its own runner, with the same ~/ci checkout, Postgres and logs, no SSH)
cfg=${AGENT_LANES_CONFIG:-$HOME/.config/agent-lanes/config}
# shellcheck disable=SC1090
[ -f "$cfg" ] && . "$cfg"
lanes_cfg=${AGENT_LANES_CONFIG:-$HOME/.config/agent-lanes/config}
[ "$lanes_cfg" = "$cfg" ] || [ ! -f "$lanes_cfg" ] || . "$lanes_cfg"
user=${REMOTE_CI_USER:-$(id -un)}
usage() {
  cat <<'USAGE'
remote-ci check [--force] [--worktree] [--run "<cmd>"] [--summary] [<commit>]   run the check on the runner
remote-ci fail [--tail] [SHA|latest]                                    redacted summary or last 80 log lines
remote-ci blame SHA LANE...                                            rank failing-file overlaps (read-only)
remote-ci status                                                       lock, runs, disk, Postgres
remote-ci log [-C n] <regex>                                           grep the latest run's log (no colors)
remote-ci info                                                         one-line route, ssh command, ports, paths (cheap lookup)
remote-ci setup [runner]                                               prepare a named runner for this project
remote-ci init                                                         add .remote-ci.conf + pre-push hook here
remote-ci freeze [reason] | thaw                                       hold new checks on the runner / resume intake
remote-ci pause [reason] | resume                                      park supported queued v2 checks / resume them
remote-ci install-runner                                               freeze, wait for running checks, install this master kit as the host kit, thaw
remote-ci upgrade start RUNNER... | status [ID] | resume ID              staged, recoverable, one-device-at-a-time upgrade
Exit codes: see ../SKILL.md (check, infrastructure, busy, cleanup).
USAGE
}
cmd=${1:-}; shift || true
[ "$cmd" = init ] && exec bash "$kit/bin/remote-ci-init" "$@"
if [ "$cmd" = upgrade ]; then
  export CI_RUNNERS="${CI_RUNNERS:-${CI_ROUTE_RUNNERS:-}}"
  for policy_key in ${!CI_RUNNER_@}; do export "$policy_key"; done
  exec python3 "$kit/bin/rolling_upgrade.py" "$@"
fi
case "$cmd" in check | fail | blame | status | setup | info | log | freeze | thaw | pause | resume | install-runner) ;; *) usage; exit 2 ;; esac
# Runner protocol this client speaks. A runner with a host kit (~/ci/kit, see install-runner) refuses pushes
# from older clients (remote/pre-receive.sh), so one admission protocol runs on the runner at a time.
protocol=2

tail_flag=""
if [ "$cmd" = fail ] && [ "${1:-}" = --tail ]; then tail_flag=--tail; shift; fi
if [ "$cmd" = fail ] || [ "$cmd" = blame ]; then
  target=${1:-latest}
  [ "$cmd" != blame ] || [ $# -ge 2 ] || exit 1
  [ "$cmd" != fail ] || [ $# -le 1 ] || exit 1
  if [ "$target" != latest ] || [ "$cmd" = blame ]; then
    [[ "$target" =~ ^[0-9a-f]{7,40}$ ]] || exit 1
  fi
fi
worktree=0 summary=0 force=0 command=""
check_args=("$@")  # A pool move resubmits with the same flags.
if [ "$cmd" = check ]; then
target=HEAD
while [ $# -gt 0 ]; do
  case "$1" in
  --force) force=1 ;;
  --worktree) worktree=1 ;;
  --summary) summary=1 ;;
  --run) [ $# -ge 2 ] || { usage >&2; exit 2; }; command=$2; shift ;;
  -h | --help) usage; exit 0 ;;
  *) target=$1 ;;
  esac
  shift
done
fi
root=$(git rev-parse --show-toplevel 2>/dev/null) || { [ "$cmd" != fail ] && [ "$cmd" != blame ] || exit 1; echo "remote-ci: not in a git repository" >&2; exit 2; }
# land pins this to the main checkout; normal calls use this repo's config.
conf=${REMOTE_CI_CONF:-$root/.remote-ci.conf}
[ -f "$conf" ] || { [ "$cmd" != fail ] && [ "$cmd" != blame ] || exit 1; echo "remote-ci: no config at $conf (run: remote-ci init)" >&2; exit 2; }
# Keep the settings used for cache identity and execution identical while queued.
conf_snapshot=$(mktemp)
chmod 600 "$conf_snapshot"
cp "$conf" "$conf_snapshot"
conf=$conf_snapshot
kit_snapshot=""
move_file=""
trap 'rm -f "$conf_snapshot" ${move_file:+"$move_file" "$move_file.new"} ${kit_snapshot:+"$kit_snapshot/"*.sh "$kit_snapshot/"*.py}; [ -z "$kit_snapshot" ] || rmdir "$kit_snapshot"' EXIT
env_needs=${REMOTE_CI_NEEDS:-}  # Per-command needs (e.g. mrun) add to the project's conf.
# shellcheck disable=SC1090
. "$conf"
if [ "$cmd" = fail ] || [ "$cmd" = blame ]; then
  case "${REMOTE_CI_NAME:-}" in *[!a-zA-Z0-9_.-]*|''|.|..) exit 1 ;; esac
fi
: "${REMOTE_CI_NAME:?set REMOTE_CI_NAME in .remote-ci.conf}"
case "$REMOTE_CI_NAME" in *[!a-zA-Z0-9_.-]*|''|.|..) echo 'remote-ci: unsafe project name' >&2; exit 2 ;; esac
case "${REMOTE_CI_SLOTS:-1}" in *[!0-9]* | "" | 0*) [ "$cmd" != fail ] && [ "$cmd" != blame ] || exit 1; echo "remote-ci: REMOTE_CI_SLOTS must be a positive integer" >&2; exit 2 ;; esac
: "${REMOTE_CI_WAIT_TIMEOUT:=10800}"
case "$REMOTE_CI_WAIT_TIMEOUT" in *[!0-9]* | "" | 0*) echo 'remote-ci: REMOTE_CI_WAIT_TIMEOUT must be a positive integer' >&2; exit 2 ;; esac

# Start the check budget before runner selection and transport setup.
submit_bounded=0
submitted_at=$(date +%s)
wait_deadline=$((submitted_at + REMOTE_CI_WAIT_TIMEOUT))
case "${REMOTE_CI_MOVE_SUBMITTED:-}:${REMOTE_CI_MOVE_DEADLINE:-}" in
  *[!0-9:]* | :* | *:) ;;
  *) submitted_at=$REMOTE_CI_MOVE_SUBMITTED wait_deadline=$REMOTE_CI_MOVE_DEADLINE ;;
esac
first_submitted=$submitted_at
[ "$cmd" != check ] || submit_bounded=1
bounded() {
  local left=$((wait_deadline - $(date +%s)))
  [ "$left" -gt 0 ] || { echo "lost-run: submission passed the wait deadline" >&2; return 74; }
  python3 "$kit/bin/client_process.py" "$left" "$@"
}
transport() {
  if [ "$submit_bounded" = 1 ]; then bounded "$@"; else "$@"; fi
}
# Optional host policy enables automatic pooling only for reviewed projects.
# Exact command rules may add needs; explicit project/environment needs survive.
if [ -n "${CI_ROUTE_POLICY:-}" ] && [ -n "${CI_ROUTE_RUNNERS:-}" ]; then
  policy_command=""
  [ "$cmd" != check ] || policy_command=${command:-${REMOTE_CI_CHECK:-pnpm run check}}
  route_needs=$(python3 "$kit/bin/route_policy.py" "$CI_ROUTE_POLICY" "$REMOTE_CI_NAME" "$policy_command")
  policy_rc=$?
  case "$policy_rc" in
    0) CI_RUNNERS=${CI_RUNNERS:-$CI_ROUTE_RUNNERS}
       REMOTE_CI_NEEDS="${REMOTE_CI_NEEDS:-} $route_needs" ;;
    10) ;; # Unlisted projects retain their existing route.
    *) echo 'remote-ci: invalid host routing policy; refusing routing' >&2; exit 74 ;;
  esac
fi
base=(-o BatchMode=yes -o ConnectTimeout=3 -o ServerAliveInterval=15 -o ServerAliveCountMax=4)
# A clean environment like an ssh session: the lane's DATABASE_URL, NODE_ENV and PATH must not reach the run.
local_sh() { env -i HOME="$HOME" USER="$user" LOGNAME="$user" SHELL=/bin/bash PATH=/usr/bin:/bin:/usr/sbin:/sbin /bin/bash -c "cd ~ && $*"; }
assignment_generation=""
runner_name=""
requested_runner=${REMOTE_CI_RUNNER:-""}
if [ "$cmd" = setup ] && [ $# -gt 0 ]; then requested_runner=$1; shift; fi
if [ -n "$requested_runner" ] && [ -z "${CI_RUNNERS:-}" ]; then
  echo 'remote-ci: named setup requires CI_RUNNERS' >&2; exit 3
fi
router=""
[ "${REMOTE_CI_HOST:-}" = local ] || router=${REMOTE_CI_DIRECT_HOST:-$(ipconfig getoption bridge0 router 2>/dev/null)}
alias_opt=(); [ -n "${REMOTE_CI_HOSTKEY_ALIAS:-}" ] && alias_opt=(-o "HostKeyAlias=$REMOTE_CI_HOSTKEY_ALIAS")
if [ "${CI_RUNNERS+x}" = x ]; then
  # Host-wide admin must never act on a scored runner, and the project's needs do not apply to it.
  case "$cmd" in freeze | thaw | pause | resume | install-runner)
    [ -n "$requested_runner" ] || { echo "remote-ci: CI_RUNNERS is set; name the runner: REMOTE_CI_RUNNER=<name> remote-ci $cmd" >&2; exit 2; }
    REMOTE_CI_NEEDS="" env_needs="" ;;
  esac
  REMOTE_CI_NEEDS="${REMOTE_CI_NEEDS:-} $env_needs"
  export CI_RUNNERS REMOTE_CI_NEEDS
  for policy_key in ${!CI_RUNNER_@}; do export "$policy_key"; done
  pool_args=(--project "$REMOTE_CI_NAME")
  [ -z "$requested_runner" ] || pool_args+=(--runner "$requested_runner")
  # Setup and admin need only a reachable host, not the project or an open queue.
  case "$cmd" in setup | freeze | thaw | pause | resume | install-runner) pool_args+=(--setup) ;; esac
  if [ "$cmd" = check ]; then
    assignment_job=$(openssl rand -hex 16) || exit 3
    pool_args+=(--job "$assignment_job")
  fi
  # Follow-ups read the logs on the runner that ran the sha (or the project's last check).
  case "$cmd" in fail | blame) pool_args+=(--lookup "$target") ;; log | status | info) pool_args+=(--lookup latest) ;; esac
  selection=$(transport python3 "$kit/bin/pool.py" "${pool_args[@]}") || exit 3
  read -r runner_name runner_route assignment_generation runner_pick <<<"$selection"
  ssh_cmd=(ssh "${base[@]}" "$runner_route")
  git_url="$runner_route:ci/projects/$REMOTE_CI_NAME/repo.git"
  git_ssh="ssh ${base[*]}"
  route="pool $runner_name${runner_pick:+ ($runner_pick)}"
elif [ "${REMOTE_CI_HOST:-}" = local ]; then
  python3 "$kit/remote/resources.py" local-allowed || exit 3
  [ "$user" = "$(id -un)" ] || { echo "remote-ci: REMOTE_CI_HOST=local runs as you; unset REMOTE_CI_USER" >&2; exit 2; }
  ssh_cmd=(local_sh)
  git_url="$HOME/ci/projects/$REMOTE_CI_NAME/repo.git"
  git_ssh=ssh
  route=local
elif [ -n "$router" ] && transport ssh "${base[@]}" ${alias_opt[@]+"${alias_opt[@]}"} "$user@$router" true 2>/dev/null; then
  ssh_cmd=(ssh "${base[@]}" ${alias_opt[@]+"${alias_opt[@]}"} "$user@$router")
  git_url="ssh://$user@$router/~/ci/projects/$REMOTE_CI_NAME/repo.git"
  git_ssh="ssh ${base[*]} ${alias_opt[*]-}"
  route="direct $router"
elif [ -n "${REMOTE_CI_HOST:-}" ] && transport ssh "${base[@]}" "$REMOTE_CI_HOST" true 2>/dev/null; then
  ssh_cmd=(ssh "${base[@]}" "$REMOTE_CI_HOST")
  git_url="$REMOTE_CI_HOST:ci/projects/$REMOTE_CI_NAME/repo.git"
  git_ssh="ssh ${base[*]}"
  route="ssh $REMOTE_CI_HOST"
else
  [ "$cmd" != info ] || echo "direct=${router:-unset} alias=${REMOTE_CI_HOSTKEY_ALIAS:-unset} ssh=${REMOTE_CI_HOST:-unset} unreachable"
  [ "$cmd" != fail ] && [ "$cmd" != blame ] || exit 1
  echo "remote-ci: runner unreachable" >&2
  exit 3
fi
remote() {
  if [ "$submit_bounded" = 1 ] && [ "$route" != local ]; then bounded "${ssh_cmd[@]}" "$@" 2>&1 | grep -v '^Pseudo-terminal'
  else "${ssh_cmd[@]}" "$@" 2>&1 | grep -v '^Pseudo-terminal'; fi
  return "${PIPESTATUS[0]}"
}
p="~/ci/projects/$REMOTE_CI_NAME"

# One client deadline covers submission, queue, all commands and cleanup.
# A local watchdog also bounds a live SSH connection that stops returning data.
wait_remote() {
  local remaining payload wait_child wait_watchdog rc
  remaining=$((wait_deadline - $(date +%s)))
  if [ "$remaining" -le 0 ]; then
    echo "lost-run: run $run total wait exceeded $REMOTE_CI_WAIT_TIMEOUT seconds (log $p/logs/$run.log)"
    return 74
  fi
  payload="deadline=\$(( \$(date +%s) + $remaining ))
    await_file() {
      while [ ! -f \"\$1\" ]; do
        if [ \"\$(date +%s)\" -ge \"\$deadline\" ]; then
          if [ -f ~/ci/pause.json ]; then
            python3 ~/ci/kit/scheduler_pause.py expire '$REMOTE_CI_NAME' '$run'; expire_rc=\$?
            if [ "\$expire_rc" = 75 ]; then
              echo 'busy: run $run reached its original deadline while parked for maintenance'
              exit 75
            fi
          fi
          echo 'lost-run: run $run total wait exceeded $REMOTE_CI_WAIT_TIMEOUT seconds (log $p/logs/$run.log)'
          exit 74
        fi
        sleep 1
      done
    }
    $1"
  if [ "$route" = local ]; then
    perl -e 'setpgrp(0,0); exec @ARGV' env -i HOME="$HOME" USER="$user" LOGNAME="$user" SHELL=/bin/bash PATH=/usr/bin:/bin:/usr/sbin:/sbin /bin/bash -c "cd ~ && $payload" &
  else
    perl -e 'setpgrp(0,0); exec @ARGV' "${ssh_cmd[@]}" "$payload" &
  fi
  wait_child=$!
  perl -e 'setpgrp(0,0); exec @ARGV' /bin/bash -c '
    while [ "$(date +%s)" -lt "$1" ]; do
      kill -0 "$2" 2>/dev/null || exit 0
      sleep 1
    done
    # Give remote deadline publication two elapsed seconds of grace.
    # A fixed or adjusted wall clock must not extend this grace indefinitely.
    sleep 2
    kill -TERM -"$2" 2>/dev/null
    sleep 1; kill -KILL -"$2" 2>/dev/null
  ' _ "$wait_deadline" "$wait_child" &
  wait_watchdog=$!
  wait "$wait_child" 2>/dev/null; rc=$?
  kill -TERM -"$wait_watchdog" 2>/dev/null || kill -TERM "$wait_watchdog" 2>/dev/null
  wait "$wait_watchdog" 2>/dev/null
  if [ "$rc" != 0 ] && [ "$rc" != 74 ] && [ "$rc" != 75 ] && [ "$(date +%s)" -ge "$wait_deadline" ]; then
    echo "lost-run: run $run total wait exceeded $REMOTE_CI_WAIT_TIMEOUT seconds (log $p/logs/$run.log)"
    return 74
  fi
  return "$rc"
}

snapshot_kit() {
  [ -z "$kit_snapshot" ] || return 0
  kit_snapshot=$(mktemp -d) || return 1
  cp "$kit/remote/"*.sh "$kit/remote/"*.py "$kit_snapshot/"
}
# Short content hash of a directory's runner scripts (names and blobs).
kit_hash() {
  # The manifest is a byte-ordered protocol, independent of the caller's locale.
  (export LC_ALL=C; cd "$1" && for script in *; do
    printf '%s\n' "$script"
    git hash-object "$script" || exit 74
  done | git hash-object --stdin | cut -c1-8)
}
# Host kit version on the runner (empty: the runner has none and this client ships its scripts).
# While ~/ci/freeze exists (maintenance), wait within the total deadline; running checks are not touched.
host_kit=""
probe_runner() {
  local state announced=0
  while :; do
    state=$(remote 'if [ -f ~/ci/freeze ]; then echo "frozen $(head -1 ~/ci/freeze | cut -c1-120)"; elif [ -f ~/ci/kit/VERSION ]; then echo "kit $(cat ~/ci/kit/VERSION)"; else echo nokit; fi') || return 74
    case "$state" in
    frozen*)
      [ "$announced" = 1 ] || echo "remote-ci: runner frozen for maintenance (${state#frozen }); waiting"
      announced=1
      if [ "$(date +%s)" -ge "$wait_deadline" ]; then
        echo "lost-run: runner stayed frozen past the total wait of $REMOTE_CI_WAIT_TIMEOUT seconds"; return 74
      fi
      sleep 15 ;;
    kit\ *) host_kit=${state#kit }; return 0 ;;
    nokit) host_kit=""; return 0 ;;
    *) echo "remote-ci: unexpected runner state: $state"; return 74 ;;
    esac
  done
}
sync_kit() {
  snapshot_kit || return 1
  local run_dir=""
  if [ -n "${1:-}" ]; then
    run_dir="$p/runs/$1"
    remote "umask 077; mkdir -p $p/runs && mkdir $run_dir 2>/dev/null" || {
      echo "remote-ci: cannot reserve run directory $run_dir"; return 1;
    }
  fi
  # Without a host kit, runner scripts travel on every call, so changes apply at once. With one, every run
  # copies the host kit (installed from master), whatever this client's checkout contains.
  if [ -z "$host_kit" ]; then
    tar -C "$kit_snapshot" -cf - . | remote 'mkdir -p ~/ci/bin; tmp=$(mktemp -d ~/ci/bin/.sync.XXXXXX) && tar -C "$tmp" -xf - && for f in "$tmp"/*; do mv -f "$f" ~/ci/bin/; done; rmdir "$tmp"' || return 1
  fi
  remote "mkdir -p $p; tmp=\$(mktemp $p/.conf.XXXXXX) && chmod 600 \"\$tmp\" && cat >\"\$tmp\" && mv -f \"\$tmp\" $p/conf" <"$conf" || return 1
  if [ -n "$run_dir" ] && [ -n "$host_kit" ]; then
    remote "mkdir -p $run_dir/bin && chmod 700 $run_dir && k=\$(cd ~/ci/kit && pwd -P) && [ \"\$(cat \$k/VERSION)\" = '$host_kit' ] && cp -p \$k/*.sh \$k/*.py $run_dir/bin/" || {
      echo "remote-ci: the runner kit changed during submission; resubmit"; return 1;
    }
  elif [ -n "$run_dir" ]; then
    tar -C "$kit_snapshot" -cf - . | remote "mkdir -p $run_dir/bin && chmod 700 $run_dir && tar -C $run_dir/bin -xf -" || return 1
  fi
  if [ -n "$run_dir" ]; then
    remote "umask 077; cat >$run_dir/conf; if [ -f $p/env.local ]; then cp $p/env.local $run_dir/env.local; fi" <"$conf" || return 1
  fi
  if [ -n "${REMOTE_CI_ENV_KEYS:-}" ] && [ -f "$root/.env" ]; then
    # Selected .env keys (e.g. test-storage credentials): copied, never printed, mode 600.
    local pattern
    pattern=$(printf '%s' "$REMOTE_CI_ENV_KEYS" | tr ' ' '\n' | sed 's/\*/[A-Z0-9_]*/g; s/^/^/; s/$/=/' | paste -sd'|' -)
    grep -E "$pattern" "$root/.env" | sed 's/^/export /' | remote "umask 077; tmp=\$(mktemp $p/.env.XXXXXX) && cat >\"\$tmp\" ${run_dir:+ && cp \"\$tmp\" $run_dir/env.local} && mv -f \"\$tmp\" $p/env.local" || return 1
  fi
}

case "$cmd" in
fail)
  # Parser runs on SSH stdin: no remote script/config writes or raw log output.
  "${ssh_cmd[@]}" "python3 - --logs $p/logs $tail_flag '$target'" <"$kit/bin/fail-summary.py" 2>/dev/null
  rc=$?; [ "$rc" = 0 ] && exit 0; exit 1 ;;
blame)
  failure=$("${ssh_cmd[@]}" "python3 - --logs $p/logs --json '$target'" <"$kit/bin/fail-summary.py" 2>/dev/null) || exit 1
  shift
  printf '%s\n' "$failure" | python3 "$kit/bin/blame.py" "$root" "$target" "$@"
  exit $? ;;
setup)
  wait_deadline=$(( $(date +%s) + REMOTE_CI_WAIT_TIMEOUT ))
  probe_runner || exit 74
  setup_script='~/ci/bin/setup.sh'; [ -z "$host_kit" ] || setup_script='~/ci/kit/setup.sh'
  sync_kit && remote "REMOTE_CI_BOOTSTRAP=1 bash $setup_script $REMOTE_CI_NAME"
  exit $?
  ;;
freeze)
  printf '%s (%s, %s)\n' "${*:-maintenance}" "$(id -un)@$(hostname -s)" "$(date '+%F %T')" |
    remote 'mkdir -p ~/ci/logs && cat >~/ci/freeze.new && mv -f ~/ci/freeze.new ~/ci/freeze' || exit 74
  echo "remote-ci: runner frozen; new checks wait, running ones finish (resume: remote-ci thaw)"
  exit 0
  ;;
thaw)
  remote 'if [ -f ~/ci/freeze ]; then mkdir -p ~/ci/logs && mv -f ~/ci/freeze ~/ci/logs/freeze.last; fi' || exit 74
  echo "remote-ci: runner thawed; waiting checks continue"
  exit 0
  ;;
pause)
  printf '%s\n' "${*:-maintenance}" | remote "s=~/ci/kit/scheduler_pause.py; [ -f \$s ] || { echo 'remote-ci: installed kit does not support durable pause' >&2; exit 75; }; python3 \$s pause" || exit $?
  echo "remote-ci: intake paused; compatible queued v2 checks are parking"
  exit 0
  ;;
resume)
  remote "s=~/ci/kit/scheduler_pause.py; [ -f \$s ] || { echo 'remote-ci: installed kit does not support durable resume' >&2; exit 75; }; python3 \$s resume" || exit $?
  echo "remote-ci: parked checks resumed; any pre-existing manual freeze is preserved"
  exit 0
  ;;
install-runner)
  # Only reviewed code becomes the host kit: a clean master checkout of this kit.
  branch=$(git -C "$kit" rev-parse --abbrev-ref HEAD 2>/dev/null)
  [ "$branch" = master ] || { echo "remote-ci: install-runner runs only from a master checkout (this kit is on ${branch:-no branch})" >&2; exit 2; }
  [ -z "$(git -C "$kit" status --porcelain -- remote)" ] || { echo "remote-ci: $kit/remote has uncommitted changes" >&2; exit 2; }
  source_rev=$(git -C "$kit" rev-parse --short=12 HEAD) || exit 74
  snapshot_kit || exit 74
  rev=$(kit_hash "$kit_snapshot") || exit 74
  froze=0
  if ! remote 'test -f ~/ci/freeze'; then
    printf 'install-runner %s (%s)\n' "$rev" "$(date '+%F %T')" | remote 'mkdir -p ~/ci/logs && cat >~/ci/freeze' || exit 74
    froze=1
  fi
  stage=$(remote 'mkdir -p ~/ci/kits && mktemp -d ~/ci/kits/.stage.XXXXXX') || exit 74
  tar -C "$kit_snapshot" -cf - . | remote "tar -C $stage -xf -" || exit 74
  # Running and queued checks finish on the kit they started with; new ones wait for the thaw.
  announced=0 drain_deadline=$(( $(date +%s) + ${REMOTE_CI_INSTALL_WAIT:-10800} ))
  while :; do
    active=$(remote "bash $stage/install-kit.sh count") || { echo "remote-ci: cannot count live runs; the runner stays frozen (remote-ci thaw)" >&2; exit 74; }
    [ "$active" = 0 ] && break
    if [ "$(date +%s)" -ge "$drain_deadline" ]; then
      echo "remote-ci: $active run(s) still live after the install wait; nothing installed; the runner stays frozen (remote-ci thaw)" >&2; exit 75
    fi
    [ "$announced" = 1 ] || echo "remote-ci: runner frozen; waiting for $active running or queued check(s) to finish"
    announced=1
    sleep 10
  done
  remote "bash $stage/install-kit.sh install $stage $rev $protocol $source_rev" || { echo "remote-ci: install failed; the runner stays frozen (remote-ci thaw)" >&2; exit 74; }
  if [ "$froze" = 1 ]; then
    remote 'mv -f ~/ci/freeze ~/ci/logs/freeze.last' || exit 74
  else
    echo "remote-ci: the runner was frozen before this install; it stays frozen (remote-ci thaw)"
  fi
  exit 0
  ;;
info)
  echo "route=$route ssh='${ssh_cmd[*]}' project=$p db_port=${REMOTE_CI_POSTGRES:+$((5400 + REMOTE_CI_POSTGRES))} node=${REMOTE_CI_NODE:-system} check='${REMOTE_CI_CHECK:-pnpm run check}' logs=$p/logs"
  exit 0
  ;;
log)
  ctx=2; [ "${1:-}" = -C ] && { ctx=$2; shift 2; }
  pattern=$(printf '%s' "${1:-== finished}" | base64)
  remote "f=\$(ls -t $p/logs/*.log | head -1); echo \"\$f\"; sed 's/\x1b\[[0-9;]*m//g' \"\$f\" | grep -E -C $ctx \"\$(echo $pattern | base64 -d)\" | head -120"
  exit $?
  ;;
status)
  remote "s=~/ci/kit/status.sh; [ -f \$s ] || s=~/ci/bin/status.sh; bash \$s $REMOTE_CI_NAME '$route' ${REMOTE_CI_SLOTS:-1} ${REMOTE_CI_EXCLUSIVE:-0}; p=~/ci/kit/scheduler_pause.py; [ ! -f \$p ] || python3 \$p status"
  exit $?
  ;;
esac

cd "$root" || exit 2
# A bare check on a dirty tree means "check what I have": include uncommitted files,
# otherwise HEAD's cached pass hides the edits.
if [ -z "${REMOTE_CI_MOVE_SHA:-}" ] && [ "$worktree" = 0 ] && [ "$target" = HEAD ] && [ -n "$(git status --porcelain --untracked-files=normal)" ]; then
  echo "remote-ci: uncommitted changes found; checking them too (--worktree)."
  worktree=1
fi
if [ -n "${REMOTE_CI_MOVE_SHA:-}" ]; then
  # A pool move checks the first submission's commit, never a new worktree snapshot.
  sha=$(git rev-parse --verify --quiet "$REMOTE_CI_MOVE_SHA^{commit}") || exit 2
elif [ "$worktree" = 1 ]; then
  # Snapshot tracked and untracked (not ignored) files through a throwaway index.
  index=$(mktemp)
  GIT_INDEX_FILE=$index git read-tree HEAD
  GIT_INDEX_FILE=$index git add -A
  sha=$(git commit-tree "$(GIT_INDEX_FILE=$index git write-tree)" -p HEAD -m "remote-ci worktree snapshot")
  rm -f "$index"
else
  sha=$(git rev-parse "$target^{commit}") || exit 2
fi
# Pool: remember the runner for this sha, so fail/blame/log follow-ups read the same logs.
[ -z "$runner_name" ] || python3 "$kit/bin/pool.py" --project "$REMOTE_CI_NAME" --runner "$runner_name" --record "$sha" || exit 3
# A pass identifies code, project settings and the runner scripts that run it (the host kit when installed).
probe_runner || exit 74
# Read only the host flag. V1 must not run metadata helpers or open V2 state.
scheduler_probe='for task_cfg in "$HOME/.config/agent-lanes/config" "$HOME/.config/agent-lanes/config"; do
  [ ! -f "$task_cfg" ] || . "$task_cfg" >/dev/null 2>&1 || exit 74
  done; printf "%s" "${AGENT_CI_SCHEDULER:-v1}"'
submission_scheduler=$(remote "$scheduler_probe") || exit 74
case "$submission_scheduler" in v1|v2) ;; *) echo "remote-ci: invalid host scheduler" >&2; exit 74 ;; esac
snapshot_kit || exit 74
if [ -n "$host_kit" ]; then kit_rev=$host_kit; else kit_rev=$(kit_hash "$kit_snapshot") || exit 74; fi
if [ "$submission_scheduler" = v2 ]; then
  if [ -n "${REMOTE_CI_MOVE_METADATA:-}" ]; then submission_metadata=$REMOTE_CI_MOVE_METADATA
  else submission_metadata=$(REMOTE_CI_TASK="${REMOTE_CI_TASK:-}" python3 "$kit/remote/scheduler_submit.py" "$root" "$target") || exit 74; fi
fi
nonce=$(openssl rand -hex 12) || { echo "remote-ci: cannot create run ID" >&2; exit 74; }
case "$nonce" in *[!0-9a-f]* | "") echo "remote-ci: invalid random run ID" >&2; exit 74 ;; esac
[ "${#nonce}" = 24 ] || { echo "remote-ci: invalid random run ID" >&2; exit 74; }
run=$(date +%Y%m%d-%H%M%S)-${sha:0:8}-$$-$nonce
sync_kit "$run" || exit 74
# First-time setup runs this run's own scripts and config (the ones its pass key hashes), within the total wait.
remote "test -f $p/.ready" || wait_remote "bash $p/runs/$run/bin/setup.sh $REMOTE_CI_NAME \$((deadline - \$(date +%s)))" || exit 74
# Actual platform/tools/services must match before accepting a result.
encoded=$(printf '%s' "${command:-${REMOTE_CI_CHECK:-pnpm run check}}" | base64 | tr -d '\n')
cache_mode=full; [ -z "$command" ] || cache_mode=targeted
if remote "test -f $p/runs/$run/bin/cache.py"; then
# The login shell can be zsh (macOS): lib.sh needs BASH_SOURCE and a no-match glob is fatal there.
key_script="set -a; . $p/runs/$run/bin/lib.sh; load_project $REMOTE_CI_NAME $p/runs/$run/conf || exit; \
  CACHE_TREE=$(git rev-parse "$sha^{tree}") CACHE_CONFIG=$(git hash-object "$conf") CACHE_KIT=$kit_rev \
  CACHE_MODE=$cache_mode CACHE_COMMAND=\"\$(printf '%s' '$encoded' | platform_decode)\" \
  python3 $p/runs/$run/bin/cache.py execution-key --env-file $p/runs/$run/env.local"
tree=$(remote "bash -c $(printf %q "$key_script")") || exit 74
case "$tree" in ''|*[!0-9a-f]*) echo 'remote-ci: execution identity unavailable' >&2; exit 74 ;; esac
[ "${#tree}" = 64 ] || exit 74
pass_script="for pending in ~/ci/projects/*/results/*.cleanup; do
  [ ! -f \"\$pending\" ] || exit 76
  done; python3 $p/runs/$run/bin/cache.py pass-valid --path $p/results/tree-$tree.pass"
if [ "$force" = 0 ] && [ -z "$command" ] && remote "bash -c $(printf %q "$pass_script")"; then
  remote "printf '0\\n' >$p/results/$run.exit.new && mv $p/results/$run.exit.new $p/results/$run.exit &&
    python3 $p/runs/$run/bin/cache.py register --key run-$REMOTE_CI_NAME-$run --kind run --path $p/runs/$run" || exit 74
  echo "remote-ci: this exact code already passed on the runner ($route); skipping."
  exit 0
fi
else
  # An older host kit cannot prove execution identity. Run without result reuse.
  tree=uncached-$nonce
  echo 'remote-ci: host cache identity unavailable; result reuse disabled'
fi
# One ref per run, so parallel callers never overwrite each other's commit while queued.
# With a host kit, the push carries this client's protocol for the runner's pre-receive floor.
push_options=(); [ -z "$host_kit" ] || push_options=(-o "remote-ci=$protocol")
GIT_SSH_COMMAND="$git_ssh" bounded git push -q --force ${push_options[@]+"${push_options[@]}"} "$git_url" "$sha:refs/heads/run/$run" || exit 74
echo "remote-ci: $REMOTE_CI_NAME ${sha:0:8} on the runner via $route (log $p/logs/$run.log)"
resource_mode=runner; [ "$route" != local ] || resource_mode=local
if [ "$submission_scheduler" = v2 ]; then
  printf '%s\n' "$submission_metadata" |
    remote "umask 077; cat >$p/runs/$run/submission.json.new && mv $p/runs/$run/submission.json.new $p/runs/$run/submission.json" || exit 74
fi
encoded=$(printf '%s' "$command" | base64)
launch_gate='[ ! -f ~/ci/freeze ] || { echo "remote-ci: runner frozen after submission; resubmit"; exit 75; }'
launch_gate="$launch_gate; [ \"\$($scheduler_probe)\" = '$submission_scheduler' ] || { echo 'remote-ci: scheduler changed after submission; resubmit'; exit 75; }"
[ -z "$host_kit" ] || launch_gate="$launch_gate; [ \"\$(cat ~/ci/kit/VERSION 2>/dev/null)\" = '$host_kit' ] || { echo 'remote-ci: runner kit changed after submission; resubmit'; exit 75; }"
remote "$launch_gate; nohup bash $p/runs/$run/bin/run.sh $REMOTE_CI_NAME $sha $tree $run '$encoded' $force '$resource_mode' '$assignment_generation' '$first_submitted' </dev/null >/dev/null 2>&1 &" || exit 74
submit_bounded=0
# Pool: a v2 run still queued after REMOTE_CI_MOVE_AFTER seconds may move once to another ready runner.
mover=""
move_after=${REMOTE_CI_MOVE_AFTER:-60}
case "$move_after" in ''|*[!0-9]*) move_after=60 ;; esac
if [ -n "$runner_name" ] && [ -z "$requested_runner" ] && [ "${REMOTE_CI_MOVE:-1}" != 0 ] && [ "$submission_scheduler" = v2 ] &&
   move_file=$(mktemp); then
  perl -e 'setpgrp(0,0); exec @ARGV' python3 "$kit/bin/pool_move.py" --project "$REMOTE_CI_NAME" --source "$runner_name" \
    --run "$run" --after "$move_after" --gap "${REMOTE_CI_MOVE_GAP:-5}" --out "$move_file" </dev/null >/dev/null 2>&1 &
  mover=$!
fi
# The source run exits 79 only after a withdraw: resubmit the same snapshot to the named runner.
finish_check() {
  local rc=$1 dest=""
  if [ -n "$mover" ]; then
    kill -TERM -"$mover" 2>/dev/null || kill -TERM "$mover" 2>/dev/null
    wait "$mover" 2>/dev/null
    dest=$(cat "$move_file" 2>/dev/null)
    rm -f "$move_file" "$move_file.new"
  fi
  if [ "$rc" = 79 ]; then
    case "$dest" in ''|*[!A-Za-z0-9_]*) echo "lost-run: run $run was withdrawn without a destination (log $p/logs/$run.log)"; exit 74 ;; esac
    echo "remote-ci: moved $run from $runner_name to $dest after $(( $(date +%s) - submitted_at ))s queued"
    REMOTE_CI_RUNNER=$dest REMOTE_CI_MOVE=0 REMOTE_CI_CONF=$conf_snapshot REMOTE_CI_MOVE_SHA=$sha \
      REMOTE_CI_MOVE_SUBMITTED=$submitted_at REMOTE_CI_MOVE_DEADLINE=$wait_deadline REMOTE_CI_MOVE_METADATA="${submission_metadata:-}" \
      /bin/bash "$kit/bin/remote-ci" check ${check_args[@]+"${check_args[@]}"}
    exit $?
  fi
  [ "$rc" != 77 ] || echo "remote-ci: superseded"
  exit "$rc"
}
# If this connection drops, the run still finishes and cleans up on the runner (see: remote-ci status).
if [ "$summary" = 1 ]; then
  echo "remote-ci: full log on the runner at $p/logs/$run.log"
  wait_remote "done=$p/results/$run.exit
    await_file \"\$done\"
    log=$p/logs/$run.log
    followed=\$(sed -n 's/^== following run \([a-zA-Z0-9_.-][a-zA-Z0-9_.-]*\) sha .*/\1/p' \"\$log\" | head -1)
    set -- \"\$log\"
    if [ -n \"\$followed\" ] && [ -f $p/logs/\$followed.log ]; then
      set -- $p/logs/\$followed.log \"\$log\"
    fi
    sed 's/\x1b\[[0-9;]*m//g' \"\$@\" |
      grep -E '${REMOTE_CI_SUMMARY_PATTERN:-Test Files|Tests  |FAIL |error TS|ERR_|Failed:|✖|passed|failed|Error:}|timeout after|busy:|lost-run:|== following|== moved to|== withdrawn|== cached:|== timing|== resources|runner cleanup pending:|== cleanup recovered:|maximum resident' |
      sed 's/^[^ :]*:[a-z:-]*: *//' | grep -v -E '^== (check-result|finished) rc=|^runner cleanup pending:' | awk '!seen[\$0]++' | head -60
    grep -h '^runner cleanup pending:' \"\$@\" | awk '!seen[\$0]++'
    grep -h -E '^== (check-result|finished) rc=' \"\$@\" | awk '!seen[\$0]++'
    exit \$(cat \$done)"
  rc=$?
  [ -z "${mover:-}" ] && [ "$rc" != 79 ] || finish_check "$rc"
  [ "$rc" != 77 ] || echo "remote-ci: superseded"
  exit $rc
fi
wait_remote "log=$p/logs/$run.log; done=$p/results/$run.exit
  await_file \"\$log\"
  tail -n +1 -f \$log & t=\$!
  trap 'kill \"\$t\" 2>/dev/null; wait \"\$t\" 2>/dev/null' EXIT HUP INT TERM
  await_file \"\$done\"
  sleep 1; exit \$(cat \$done)"
rc=$?
[ -z "${mover:-}" ] && [ "$rc" != 79 ] || finish_check "$rc"
[ "$rc" != 77 ] || echo "remote-ci: superseded"
exit "$rc"
