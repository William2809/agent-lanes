#!/bin/sh
# ABOUTME: One-line worker launch: picks model/sandbox, optional wt-dev worktree, prepends the
# ABOUTME: repo's standing header, keeps logs in a stable place so `batches wait/report NAME` finds them.
# Usage (inside a repo): wk NAME [-w | -d WORKTREE] [-o "PATH ..."] -t FEATURE:REASON [-m PRESET] [-f PROMPT_FILE]   (prompt on stdin otherwise)
#   -w        run in wt-dev worktree NAME (created from the current branch if missing)
#   -d WT     run in an existing wt-dev worktree WT (name or path), e.g. a second worker in a batch's worktree
#   -m        a model preset from `ao-model ls` (default: build). Presets with a read-only sandbox are reviewers.
#   header    ~/.claude/state/headers/<repo>.md, placeholders {{DIR}} {{URL}} {{BASE}} {{NAME}} {{LOGDIR}}; Astra gets a read-only line instead
#   -t FEATURE:REASON  required for new launches (WK_ALLOW_UNTAGGED=1 overrides); REASON = new | rework (after owner feedback) | bounce | review | review-fix | other
#   -r [MSG|-] resume NAME's session (Codex or another harness) (MSG '-' = read it from stdin, use a quoted heredoc) (same model/sandbox/dir) after a capacity error or a cut-off run
# Then: batches wait NAME… (background) · batches report NAME…
set -eu
# Scripts ship next to this file: <repo>/bin/wk -> <repo>/skills (no fixed install location).
skills=$(cd "$(dirname "$(readlink -f "$0")")/../skills" && pwd)
tool_rev=$(git -C "$skills/.." rev-parse HEAD 2>/dev/null || echo unknown)
_run_scripts="$skills/agent-workers/scripts"
. "$_run_scripts/state.sh"
. "$_run_scripts/run-record.sh"
# mq publishes a unique durable intent before invoking wk. Cancelled intents cannot fork late.
if [ -n "${WK_LAUNCH_INTENT:-}" ]; then
  [ -d "$WK_LAUNCH_INTENT" ] || { echo "wk: repair launch cancelled" >&2; exit 1; }
  echo $$ >"$WK_LAUNCH_INTENT/pid"
fi
launch_lock=""; pending_slot=""
trap '[ -z "$pending_slot" ] || ctrash "$pending_slot" >/dev/null; [ -z "$launch_lock" ] || ops_unlock "$launch_lock"' EXIT
trap 'exit 1' HUP INT TERM
name=${1:?usage: wk NAME [-w] -t FEATURE:REASON [-m model] [-f file] | wk NAME -r [msg]}; shift
if [ "${1:-}" = "-r" ]; then
  top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  # Logs are named after the MAIN checkout, also when resuming from inside a linked worktree.
  main=$(cd "$top" && cd "$(git rev-parse --git-common-dir 2>/dev/null || echo .git)/.." 2>/dev/null && pwd || echo "$top")
  logs="$HOME/.claude/state/logs/$(basename "$main")"; log="$logs/$name.log"
  [ -f "$log" ] || { echo "no log $log" >&2; exit 1; }
  if ops_running "$log"; then
    if batches --all 2>/dev/null | awk -v n="$name" '$1==n && $2=="STALLED" {f=1} END {exit !f}'; then
      echo "$name is still running (STALLED; stop it with batches pause --stalled $name before resuming)" >&2
    else echo "$name is still running" >&2; fi
    exit 1
  fi
  # A worker stopped by `batches pause` is known dead (pid checked above): skip the recent-log guard.
  if ops_is_paused "$name" "$log"; then paused=1; else paused=0; fi
  # A resume that failed at startup leaves a log without a session header: read the newest older log that has one.
  src="$log"
  ops_plain "$log" | head -20 | grep -q '^session id: ' || src=$(ls -t "$logs/$name".[0-9]*-[0-9]*.log 2>/dev/null | while read -r f; do ops_plain "$f" | head -20 | grep -q '^session id: ' && { echo "$f"; break; }; done)
  [ -n "$src" ] || src="$log"
  [ "$paused" != 1 ] && [ "$src" = "$log" ] && ! ops_completed "$log" && [ $(( $(date +%s) - $(ops_stat %m %Y "$log") )) -lt 180 ] && { echo "$name log was written <3 min ago; probably still running (check: batches)" >&2; exit 1; }
  hv() { ops_plain "$src" | sed -n "1,20s/^$1: //p" | head -1; }
  sid=$(hv "session id"); model=$(hv model); eff=$(hv "reasoning effort"); sb=$(hv sandbox | cut -d" " -f1); dir=$(hv workdir); prov=$(hv provider)
  [ -n "$sid" ] && [ -d "$dir" ] || { echo "cannot read session id/workdir from $log" >&2; exit 1; }
  [ "${2:-}" = "-" ] && set -- "$1" "$(cat)"  # MSG '-' = message on stdin (quoted heredoc); bare -r never reads stdin (it hung in background shells)
  msg=${2:-"You were cut off (model capacity error). Continue the same task from where you stopped: check git status/diff in your directory, finish the remaining steps and checks, then give the final report in the requested format."}
  # Resumes also reserve capacity before publishing a new writer.
  launch_lock="$HOME/.claude/state/mq/$(basename "$main")/launch.lock"
  mkdir -p "$(dirname "$launch_lock")"; ops_lock "$launch_lock" || exit 1
  if ops_running "$log"; then echo "$name is still running" >&2; exit 1; fi
  # The name/log may have been reused while waiting. mq resumes only its own writable lane.
  sid=$(hv "session id"); model=$(hv model); eff=$(hv "reasoning effort"); sb=$(hv sandbox | cut -d" " -f1); dir=$(hv workdir); prov=$(hv provider); h=$(hv harness)
  [ -n "$sid" ] && [ -d "$dir" ] || { echo "cannot read session id/workdir from $log" >&2; exit 1; }
  preset=resume; record_route=codex; resume_route=""
  if [ -f "$src.run" ]; then
    rv() { sed -n "s/^$1=//p" "$src.run" | head -1; }
    model=$(rv model); sb=$(rv sandbox); dir=$(rv dir); h=$(rv harness)
    preset=$(rv preset); record_route=$(rv route); eff=$(rv effort)
    if [ "$h" = codex ] && [ "$record_route" != codex ]; then resume_route="--profile $record_route"; fi
  fi
  if [ -n "${WK_RESUME_DIR:-}" ]; then
    [ "$dir" = "$WK_RESUME_DIR" ] && [ "$sb" != read-only ] || { echo "wk: $name session does not match writable lane $WK_RESUME_DIR" >&2; exit 1; }
  fi
  [ "$dir" = "$main" ] || ops_writer_guard "$main" "$dir" "$sb" || exit $?
  old="$logs/$name.$(date +%m%d-%H%M%S).$$.log"; ops_archive "$log" "$old" || { echo "$name is still running" >&2; exit 1; }
  cfg=${AGENT_LANES_CONFIG:-$HOME/.config/agent-lanes/config}; [ -f "$cfg" ] && . "$cfg"; codex=${CODEX_BIN:-$(command -v codex || true)}
  [ "$eff" = xhigh ] && [ -z "${WK_ALLOW_XHIGH:-}" ] && eff=high  # effort cap: xhigh runs as high unless WK_ALLOW_XHIGH is set
  [ -z "${WK_LAUNCH_INTENT:-}" ] || [ -d "$WK_LAUNCH_INTENT" ] || { echo "wk: repair launch cancelled" >&2; exit 1; }
  ops_run_record "$log" "$preset" "${h:-codex}" "$record_route" "$model" "$eff" "$sb" "$dir" "$sid" || exit 1
  if [ -n "$h" ] && [ "$h" != codex ]; then
    [ "$src" = "$log" ] && src=$old
    (cd "$dir" || exit 1; ops_launch "$log" "$dir" "$sb" "$preset" "$run_id" python3 "$_run_scripts/harness_run.py" resume "$src" "$msg" "$eff")
    echo "resumed $name ($h $model $eff, $sid); previous log $old"; exit 0
  fi
  (cd "$dir" || exit 1; ops_launch "$log" "$dir" "$sb" "$preset" "$run_id" "$codex" exec $resume_route --color never resume -o "$log.$run_id.last" --model "$model" -c "model_reasoning_effort=\"$eff\"" -c "sandbox_mode=\"$sb\"" ${prov:+-c "model_provider=\"$prov\""} \
    --skip-git-repo-check "$sid" "$msg")
  echo "resumed $name ($model $eff, $sid); previous log $old"; exit 0
fi
# Disk guard: a full disk has wedged Docker/Postgres and killed every running worker.
# No new launches below WK_MIN_FREE_GB (default 15) free. WK_DISK_OK=1 overrides (WK_FORCE does not).
free_gb=$(df -g "$HOME" 2>/dev/null | awk 'NR==2{print $4}')
case "$free_gb" in ''|*[!0-9]*) ;; *)
  if [ "$free_gb" -lt "${WK_MIN_FREE_GB:-15}" ] && [ "${WK_DISK_OK:-0}" != 1 ]; then
    echo "wk: only ${free_gb} GB free (< ${WK_MIN_FREE_GB:-15}); not launching. Free space (finished worktrees' apps/web/.next, docker system df) or WK_DISK_OK=1" >&2; exit 1
  fi ;;
esac
wt=0; m=${WK_DEFAULT_PRESET:-build}; file=""; into=""; own=""; tag=""
while [ $# -gt 0 ]; do case "$1" in -w) wt=1 ;; -m) m=$2; shift ;; -f) file=$2; shift ;; -d) into=$2; shift ;; -o) own=$2; shift ;; -t) tag=$2; shift ;; *) echo "bad arg $1" >&2; exit 2 ;; esac; shift; done
if [ -z "$tag" ] && [ "${WK_ALLOW_UNTAGGED:-0}" != 1 ]; then
  echo "wk: -t FEATURE:REASON is required (WK_ALLOW_UNTAGGED=1 overrides)" >&2; exit 2
fi
if [ -n "$tag" ]; then case "$tag" in :*) echo "wk: -t needs a nonempty FEATURE" >&2; exit 2 ;; *:new|*:rework|*:bounce|*:review|*:review-fix|*:other) ;;
  *) echo "wk: -t wants FEATURE:REASON, REASON one of new rework bounce review review-fix other" >&2; exit 2 ;; esac; fi
preset=$("$skills/../bin/ao-model" get "$m") || exit 2  # the sibling copy: a worktree checkout tests its own presets code
set -- $preset; model=$1 eff=$2 sb=$3 route=$4 harness=${5:-codex}
# Plan guard: no new Codex launches near the Codex limit (overflow would spend credits). WK_FORCE=1 overrides.
if [ "$harness" = codex ] && command -v codex-limit >/dev/null && [ "${WK_FORCE:-0}" != 1 ]; then
  pct=$(codex-limit --pct 2>/dev/null) || pct=""
  case "$pct" in ''|*[!0-9]*) ;; *)
    [ "$pct" -lt "${WK_MAX_PCT:-100}" ] || { echo "wk: Codex plan at ${pct}% used; not launching (WK_FORCE=1 to override)" >&2; exit 1; } ;;
  esac
fi
top=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
# Inside a linked worktree, name logs/headers after the main checkout, not the worktree.
main=$(cd "$top" && cd "$(git rev-parse --git-common-dir 2>/dev/null || echo .git)/.." 2>/dev/null && pwd || echo "$top"); repo=$(basename "$main")
base=$(git -C "$top" rev-parse --abbrev-ref HEAD 2>/dev/null || echo main)
logs="$HOME/.claude/state/logs/$repo"; mkdir -p "$logs"; log="$logs/$name.log"
if ops_running "$log"; then echo "$name is already running" >&2; exit 1; fi
dir=$top; url=""
if [ -n "$own" ] && [ "$wt" -eq 0 ] && [ -z "$into" ] && [ "$top" = "$main" ]; then
  echo "wk: -o ignored in the main checkout (claims are for -w/-d worktrees)"
  own=""
fi
# File claims (merge queue): a new build worktree must claim the paths it will edit, and may not
# overlap another live worktree's claim or its actual changes. A claim dies with its worktree.
if [ $wt -eq 1 ] && [ -z "$own" ] && [ "${WK_FORCE:-0}" != 1 ]; then
  echo "wk: -w needs -o \"PATH ...\" (dirs/files this batch owns, e.g. -o apps/web/modules/invoice); WK_FORCE=1 skips" >&2; exit 2; fi
body=$( [ -n "$file" ] && cat "$file" || cat ); [ -n "$body" ] || { echo "empty prompt" >&2; exit 2; }
# Reserve capacity briefly; database/dependency/server setup must not hold this lock.
launch_lock="$HOME/.claude/state/mq/$repo/launch.lock"
mkdir -p "$(dirname "$launch_lock")/pending"; ops_lock "$launch_lock" || exit 1
slot="$(dirname "$launch_lock")/pending/$name"
if [ -f "$slot" ]; then
  IFS="$(printf '\t')" read -r preparing _ <"$slot" || preparing=""
  ops_pid_live "$preparing" && { echo "$name is already preparing a worktree" >&2; exit 1; }
fi
if [ $wt -eq 1 ]; then
  [ "$sb" = read-only ] && { echo "-w needs a build preset (read-only presets are reviewers: use -d WT)" >&2; exit 2; }
  dir=$(wt-dev path "$name")
  ops_writer_guard "$main" "$dir" "$sb" || exit $?
  reservation=$(mktemp "$(dirname "$slot")/.slot.XXXXXX")
  printf '%s\t%s\n' "$$" "$dir" >"$reservation" && mv "$reservation" "$slot" || exit 1
  pending_slot=$slot
  ops_unlock "$launch_lock"
  [ -d "$dir" ] || (cd "$top" && wt-dev new "$name" --from "$base" >/dev/null) || { echo "wt-dev new $name failed" >&2; exit 1; }
  u=$(wt-dev ls 2>/dev/null | awk -v n="$name" '$1==n {print $3}'); [ -n "$u" ] && url=" (dev server $u)"
  ops_lock "$launch_lock" || exit 1
elif [ -n "$into" ]; then
  dir=$(wt-dev path "$into" 2>/dev/null || true); [ -d "$dir" ] || dir=$into; [ -d "$dir" ] || { echo "no worktree $into" >&2; exit 1; }
  n=$(basename "$dir"); u=$(wt-dev ls 2>/dev/null | awk -v n="$n" '$1==n {print $3}'); [ -n "$u" ] && url=" (dev server $u)"
fi
dir=$(cd "$dir" && pwd -P)
if [ "$wt" = 1 ] || [ -n "$into" ]; then ops_writer_guard "$main" "$dir" "$sb" "$pending_slot" || exit $?; fi
if [ -n "$own" ]; then
  hit=$(cd "$main" && MQ_FORCE=${WK_FORCE:-0} mq claim "$(basename "$dir")" $own) || { [ -z "$hit" ] || printf '%s\n' "$hit" >&2; echo "wk: not launching $name: paths owned elsewhere. Join that batch (-d WT) or wait for it to land (WK_FORCE=1 overrides)" >&2; exit 1; }
fi
# Recheck after acquiring the launch lock so concurrent callers cannot reuse a worker name.
if ops_running "$log"; then echo "$name is already running" >&2; exit 1; fi
[ ! -f "$log" ] || ops_archive "$log" "$logs/$name.$(date +%m%d-%H%M%S).$$.log" || { echo "$name is still running" >&2; exit 1; }
p="$logs/$name.prompt"
# Workers commit only inside their own wt-dev worktree; in the main checkout they leave edits for the lead.
if [ "$dir" != "$main" ] && wt-dev ls 2>/dev/null | awk -v n="$(basename "$dir")" '$1==n{f=1} END{exit !f}'; then
  git='Commit your finished, checked work in this worktree with `wtcommit "type(scope): message"` (explicit paths; one commit per logical change). Never push, reset, stash, force or touch other branches'
else git='Never change git state (no stage/commit/checkout/reset/stash/push); leave edits uncommitted for the lead'; fi
if [ "$sb" = read-only ]; then hdr="Read-only work on the repo at the current directory: do not edit anything. English. Never print secrets. Be terse: ranked findings with file:line, no preamble or restating the task."
elif [ -f "$HOME/.claude/state/headers/$repo.md" ]; then hdr=$(sed -e "s#{{DIR}}#$dir#g" -e "s#{{URL}}#$url#g" -e "s#{{BASE}}#$base#g" -e "s#{{NAME}}#$name#g" -e "s#{{LOGDIR}}#$logs#g" -e "s#{{GIT}}#$git#g" "$HOME/.claude/state/headers/$repo.md")
else hdr="Working directory: $dir$url. English. Never print secrets. $git."; fi
case "$hdr" in *"Report style"*) ;; *) hdr="$hdr
Report style: about 80% ASD-STE100 (short sentences, one fact each, active voice, plain words). Final report fields: Changed: · Verified live: (command → result) · Verified by stub or reasoning only: · Not done / risks:. A claim without a live check never goes under Verified live." ;; esac
# Writers get the test rule unless the repo header has its own: a test's expected result must not come from the code.
case "$sb:$hdr" in read-only:*|*"Test rule"*) ;; *) hdr="$hdr
Test rule: add or change a test only for a named requirement (a behavior card line or the brief) or a reproduced defect. Never take the expected value from the code under test. A bug-fix test must fail on the old code first. Never weaken, skip or delete an existing assertion to get green; report it instead. Per test, report: requirement, boundary tested, gaps." ;; esac
printf '%s\n%s\n' "$hdr" "$body" >"$p"
[ -z "${WK_LAUNCH_INTENT:-}" ] || [ -d "$WK_LAUNCH_INTENT" ] || { echo "wk: repair launch cancelled" >&2; exit 1; }
launch_lock=$launch_lock WK_PRESET=$m WK_ROUTE=$route WK_HARNESS=$harness sh "$skills/agent-workers/scripts/run-worker.sh" "$model" "$eff" "$sb" "$dir" "$p" "$log" >/dev/null || { echo "wk: launch of $name FAILED (run-worker refused; see above)" >&2; exit 1; }
where=""; [ "$dir" = "$main" ] && [ "$sb" != "read-only" ] && where=" — MAIN CHECKOUT (edits land on the branch; use -w for a worktree)"
# Tags append the tool revision; the first five fields retain their meaning (workers.tsv stays four).
if [ -n "$tag" ]; then printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%s)" "$repo" "$name" "${tag%%:*}" "${tag#*:}" "$tool_rev" >>"$HOME/.claude/state/worker-tags.tsv"
else echo "wk: no -t FEATURE:REASON tag (loop-stats can't count rework for $name)" >&2; fi
[ -z "$pending_slot" ] || ctrash "$pending_slot" >/dev/null; pending_slot=""
ops_unlock "$launch_lock"; launch_lock=""
hl=""; [ "$harness" = codex ] || hl="$harness "
echo "started $name: $hl$model $eff${url:+ @$name$url}$where"
# Unlanded worktrees touching the same files conflict at land: say so now, not later.
(cd "$main" 2>/dev/null && sh "$skills/agent-workers/scripts/batches.sh" overlap) || true
