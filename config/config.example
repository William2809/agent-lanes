# agent-lanes machine settings. Copy to ~/.config/agent-lanes/config (never commit it).
# Sourced as shell by remote-ci, wk and run-worker.

# remote-ci: where heavy checks run. Leave unset to use only the direct route.
# REMOTE_CI_USER=you                    # ssh user on the runner (default: your login)
# REMOTE_CI_DIRECT_HOST=192.0.2.10      # direct link address (default: the bridge0 router, e.g. a Thunderbolt bridge)
# REMOTE_CI_HOSTKEY_ALIAS=runner-direct # ssh HostKeyAlias for the direct route
# REMOTE_CI_HOST=runner                 # ssh host (from ~/.ssh/config) for the fallback route, e.g. over a VPN
# REMOTE_CI_HOST=local                  # standalone: no second machine; this one is its own runner (no SSH)

# Codex CLI binary (default: `codex` on PATH)
# CODEX_BIN=/path/to/codex
# Codex profile used by `run-worker.sh --lead` (a proxy that lets a worker spawn other providers' subagents)
# AGENT_LANES_LEAD_PROFILE=my-proxy

# Shared host resource budget (set these on the machine executing checks).
# Start with these conservative defaults.
# AGENT_CI_MAX_JOBS=1
# AGENT_CI_MAX_WORKERS=2
# AGENT_CI_CPU_RESERVE=2
# AGENT_CI_MEM_RESERVE_MB=2048
# AGENT_CI_WORKER_MB=2048
# Local mode always grants one worker; framework flags must respect AGENT_CI_WORKERS.

# Optional remote runner pool; aliases and capabilities belong on the submitting host.
# Set up the project on each compatible runner before enabling these entries.
# CI_RUNNERS='mac=runner-mac:macos linux=runner-linux:linux'
# CI_RUNNER_mac_EXPECTED_SECONDS=300
# CI_RUNNER_linux_EXPECTED_SECONDS=300
# CI_RUNNER_linux_ENABLED=1
# Projects can restrict eligibility with REMOTE_CI_NEEDS=macos (space-separated capabilities).
# Host administration must name a runner, e.g. REMOTE_CI_RUNNER=mac remote-ci freeze.
